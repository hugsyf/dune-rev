<SummaryCards xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="DunePlayTimeCard" Style="{DynamicResource DunePlayTimeLayout}" Visibility="{Binding Visibility, ElementName=PART_ElemPlayTime, Mode=OneWay}">
        <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DetailViewCardBorder}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=DuneBasicSurface}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="DunePlayTimeHeading" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="" Style="{StaticResource IconFontStyle}" FontSize="20" HorizontalAlignment="Left" />
                <Label Name="PART_ElemPlayTime" Grid.Column="2" Content="{DynamicResource LOCTimePlayed}" Margin="0" />
            </Grid>
            <Grid x:Name="DunePlayTimeValue" Grid.Row="2" MinHeight="28" VerticalAlignment="Top">
                <TextBlock Name="PART_TextPlayTime" Style="{StaticResource DuneSummaryPrimaryText}" />
            </Grid>
        </Grid>
    </Grid>
    <Grid x:Name="DuneLastPlayedCard" Style="{DynamicResource DuneLastPlayedLayout}" Visibility="{Binding Visibility, ElementName=PART_ElemLastPlayed, Mode=OneWay}">
        <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DetailViewCardBorder}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=DuneBasicSurface}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="DuneLastPlayedHeading" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="" Style="{StaticResource IconFontStyle}" FontSize="20" HorizontalAlignment="Left" />
                <Label Name="PART_ElemLastPlayed" Grid.Column="2" Content="{DynamicResource LOCLastPlayed}" Margin="0" />
            </Grid>
            <Grid x:Name="DuneLastPlayedValue" Grid.Row="2" MinHeight="28" VerticalAlignment="Top">
                <TextBlock Name="PART_TextLastActivity" Style="{StaticResource DuneSummaryPrimaryText}" />
            </Grid>
        </Grid>
    </Grid>
    <Grid x:Name="DuneCompletionCard" Style="{DynamicResource DuneCompletionLayout}" Visibility="{Binding Visibility, ElementName=PART_ElemCompletionStatus, Mode=OneWay}">
        <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DetailViewCardBorder}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=DuneBasicSurface}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="DuneCompletionHeading" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="" Style="{StaticResource IconFontStyle}" FontSize="20" HorizontalAlignment="Left" />
                <Label Name="PART_ElemCompletionStatus" Grid.Column="2" Content="{DynamicResource LOCCompletionStatus}" Margin="0" />
            </Grid>
            <Grid x:Name="DuneCompletionValue" Grid.Row="2" MinHeight="28" VerticalAlignment="Top">
                <Grid Margin="0" MaxWidth="180" HorizontalAlignment="Left">
                    <Border Tag="{PluginStatus Plugin=felixkmh_Extras_Plugin, Status=Installed}" Visibility="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                        <Button Name="PART_ButtonCompletionStatus" Style="{StaticResource DuneSummaryCompletionButton}" Margin="0" />
                    </Border>
                    <ContentControl x:Name="ThemeExtras_SettableCompletionStatus" Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin, Status=Installed}">
                        <ContentControl.Resources>
                            <Style TargetType="UserControl" BasedOn="{StaticResource ThemeExtrasUserControlCompStatusStyle}">
                                <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="20" />
                            </Style>
                        </ContentControl.Resources>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
    <Grid x:Name="DuneRequirementsCard" ToolTip="{DynamicResource LOCDuneSystemRequirements}" AutomationProperties.Name="{DynamicResource LOCDuneSystemRequirements}">
        <Grid.Style>
            <Style TargetType="Grid" BasedOn="{StaticResource DuneRequirementsLayout}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{PluginSettings Plugin=SystemChecker, Path=EnableIntegrationButton, FallbackValue=False}" Value="True" />
                            <Condition Binding="{Binding Tag, ElementName=DuneShowRequirementsCardPreference}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DuneSummaryPluginCardBorder}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=DuneBasicSurface}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="DuneRequirementsHeading" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="" Style="{StaticResource IconFontStyle}" FontSize="20" HorizontalAlignment="Left" />
                <Label Grid.Column="2" Content="{DynamicResource LOCDuneSystemRequirements}" Margin="0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
                    <TextBlock x:Name="DuneRequirementsProviderIcon" Text="" Style="{StaticResource DuneSummaryProviderGlyph}" />
                    <TextBlock x:Name="DuneRequirementsOpenChevron" Text="" Style="{StaticResource IconFontStyle}" FontSize="12" Width="12" Foreground="{DynamicResource TextBrushDarker}" />
                </StackPanel>
            </Grid>
            <Grid x:Name="DuneRequirementsValue" Grid.Row="2" MinHeight="28" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Tag" Value="Lookup" />
                        <Style.Triggers>
                            <DataTrigger Binding="{PluginSettings Plugin=SystemChecker, Path=HasData, FallbackValue=False}" Value="True">
                                <Setter Property="Tag" Value="Ready" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{PluginSettings Plugin=SystemChecker, Path=HasData, FallbackValue=False}" Value="True" />
                                    <Condition Binding="{PluginSettings Plugin=SystemChecker, Path=IsMinimumOK, FallbackValue=False}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Tag" Value="Minimum" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{PluginSettings Plugin=SystemChecker, Path=HasData, FallbackValue=False}" Value="True" />
                                    <Condition Binding="{PluginSettings Plugin=SystemChecker, Path=IsRecommendedOK, FallbackValue=False}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Tag" Value="Recommended" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBlock x:Name="DuneRequirementsStatusGlyph" Style="{StaticResource DuneRequirementsStatusIcon}" IsHitTestVisible="False" />
                <TextBlock x:Name="DuneRequirementsStatusLabel" Grid.Column="1" Style="{StaticResource DuneRequirementsStatusText}" />
            </Grid>
        </Grid>
        <ContentControl x:Name="SystemChecker_PluginButton" Panel.ZIndex="10" Opacity="0.01" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
    <Grid x:Name="DuneHowLongToBeatCard" ToolTip="{DynamicResource LOCDuneMainStory}" AutomationProperties.Name="{DynamicResource LOCDuneMainStory}">
        <Grid.Style>
            <Style TargetType="Grid" BasedOn="{StaticResource DuneHowLongToBeatLayout}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{PluginSettings Plugin=HowLongToBeat, Path=HasData, FallbackValue=False}" Value="True" />
                            <Condition Binding="{Binding Tag, ElementName=DuneShowHowLongToBeatCardPreference}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DuneSummaryPluginCardBorder}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=DuneBasicSurface}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="DuneHowLongToBeatHeading" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="" Style="{StaticResource IconFontStyle}" FontSize="20" HorizontalAlignment="Left" />
                <Label Grid.Column="2" Content="{DynamicResource LOCDuneMainStoryLabel}" ToolTip="{DynamicResource LOCDuneMainStory}" Margin="0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
                    <ContentControl x:Name="DuneHowLongToBeatProviderIcon" Tag="{Binding Text, ElementName=DuneHowLongToBeatIconPath}" Content="" Style="{StaticResource DuneLocalPluginIcon}"></ContentControl>
                    <TextBlock x:Name="DuneHowLongToBeatOpenChevron" Text="" Style="{StaticResource IconFontStyle}" FontSize="12" Width="12" Foreground="{DynamicResource TextBrushDarker}" />
                </StackPanel>
            </Grid>
            <Grid x:Name="DuneHowLongToBeatValue" Grid.Row="2" MinHeight="28" VerticalAlignment="Top">
                <TextBlock Text="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat, FallbackValue='—'}" Style="{StaticResource DuneSummaryPrimaryText}" />
            </Grid>
            <StackPanel Grid.Row="3" VerticalAlignment="Top" Margin="0,12,0,0" Style="{StaticResource DuneWideSummaryDetails}">
                <Grid x:Name="DuneMainExtraDetail" Margin="0,0,0,4" Tag="{PluginSettings Plugin=HowLongToBeat, Path=MainExtra, FallbackValue=0}" Style="{StaticResource DunePositiveSummaryValue}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource LOCDuneMainExtra}" Style="{StaticResource DuneSummarySecondaryText}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{PluginSettings Plugin=HowLongToBeat, Path=MainExtraFormat, FallbackValue=''}" Style="{StaticResource DuneSummarySecondaryText}" />
                </Grid>
                <Grid x:Name="DuneCompletionistDetail" Tag="{PluginSettings Plugin=HowLongToBeat, Path=Completionist, FallbackValue=0}" Style="{StaticResource DunePositiveSummaryValue}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource LOCDuneCompletionist}" Style="{StaticResource DuneSummarySecondaryText}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{PluginSettings Plugin=HowLongToBeat, Path=CompletionistFormat, FallbackValue=''}" Style="{StaticResource DuneSummarySecondaryText}" />
                </Grid>
            </StackPanel>
        </Grid>
        <ToggleButton x:Name="DuneHowLongToBeatToggle" IsChecked="{Binding IsSelected, ElementName=DuneHowLongToBeatDetails, Mode=TwoWay}" Tag="{Binding Visibility, ElementName=DuneHowLongToBeatDetails}" Style="{StaticResource DuneCardToggle}" AutomationProperties.Name="{DynamicResource LOCDuneMainStoryLabel}" />
    </Grid>
    <Grid x:Name="DuneActivityCard" ToolTip="{DynamicResource LOCGameActivityTitle}" AutomationProperties.Name="{DynamicResource LOCGameActivityTitle}">
        <Grid.Style>
            <Style TargetType="Grid" BasedOn="{StaticResource DuneActivityLayout}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{PluginSettings Plugin=GameActivity, Path=HasData, FallbackValue=False}" Value="True" />
                            <Condition Binding="{Binding Tag, ElementName=DuneShowActivityCardPreference}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DuneSummaryPluginCardBorder}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=DuneBasicSurface}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="DuneActivityHeading" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="" Style="{StaticResource IconFontStyle}" FontSize="20" HorizontalAlignment="Left" />
                <Label Grid.Column="2" Content="{DynamicResource LOCDuneLastSession}" Margin="0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
                    <ContentControl x:Name="DuneActivityProviderIcon" Tag="{Binding Text, ElementName=DuneActivityIconPath}" Content="" Style="{StaticResource DuneLocalPluginIcon}"></ContentControl>
                    <TextBlock x:Name="DuneActivityOpenChevron" Text="" Style="{StaticResource IconFontStyle}" FontSize="12" Width="12" Foreground="{DynamicResource TextBrushDarker}" />
                </StackPanel>
            </Grid>
            <Grid x:Name="DuneActivityValue" Grid.Row="2" MinHeight="28" VerticalAlignment="Top">
                <TextBlock Text="{PluginSettings Plugin=GameActivity, Path=LastPlaytimeSession, FallbackValue='—'}" Style="{StaticResource DuneSummaryPrimaryText}" />
            </Grid>
            <StackPanel Grid.Row="3" VerticalAlignment="Top" Style="{StaticResource DuneActivitySummaryDetails}">
                <TextBlock x:Name="DuneLastSessionDate" Text="{PluginSettings Plugin=GameActivity, Path=LastDateSession, FallbackValue=''}" Style="{StaticResource DuneSummarySecondaryText}" />
                <TextBlock x:Name="DuneRecentActivity" Text="{PluginSettings Plugin=GameActivity, Path=RecentActivity, FallbackValue=''}" Margin="0,4,0,0" Style="{StaticResource DuneRecentActivityText}" />
            </StackPanel>
        </Grid>
        <ToggleButton x:Name="DuneActivityToggle" IsChecked="{Binding IsSelected, ElementName=DuneActivityDetails, Mode=TwoWay}" Tag="{Binding Visibility, ElementName=DuneActivityDetails}" Style="{StaticResource DuneCardToggle}" AutomationProperties.Name="{DynamicResource LOCGameActivityTitle}" />
    </Grid>
    <Grid x:Name="DuneAchievementsCard" ToolTip="{DynamicResource LOCDuneAchievements}" AutomationProperties.Name="{DynamicResource LOCDuneAchievements}">
        <Grid.Style>
            <Style TargetType="Grid" BasedOn="{StaticResource DuneAchievementsLayout}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{PluginSettings Plugin=PlayniteAchievements, Path=ModernTheme.HasAchievements, FallbackValue=False}" Value="True" />
                            <Condition Binding="{Binding Tag, ElementName=DuneShowAchievementsCardPreference}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DuneSummaryPluginCardBorder}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=DuneBasicSurface}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="DuneAchievementsHeading" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="" Style="{StaticResource IconFontStyle}" FontSize="20" HorizontalAlignment="Left" />
                <Label Grid.Column="2" Content="{DynamicResource LOCDuneAchievements}" Margin="0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
                    <ContentControl x:Name="DuneAchievementsProviderIcon" Tag="{Binding Text, ElementName=DuneAchievementsIconPath}" Content="" Style="{StaticResource DuneLocalPluginIcon}" />
                    <TextBlock x:Name="DuneAchievementsOpenChevron" Text="" Style="{StaticResource IconFontStyle}" FontSize="12" Width="12" Foreground="{DynamicResource TextBrushDarker}" />
                </StackPanel>
            </Grid>
            <Grid x:Name="DuneAchievementsValue" Grid.Row="2" MinHeight="28" VerticalAlignment="Top">
                <StackPanel Name="PART_DuneAchievements" Orientation="Horizontal">
                    <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=ModernTheme.UnlockedCount, FallbackValue='-'}" Style="{StaticResource DuneSummaryPrimaryText}" />
                    <TextBlock Text="/" Style="{StaticResource DuneSummaryPrimaryText}" />
                    <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=ModernTheme.AchievementCount, FallbackValue='-'}" Style="{StaticResource DuneSummaryPrimaryText}" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <ProgressBar Style="{StaticResource DuneSummaryProgress}" Height="4" Minimum="0" Maximum="{PluginSettings Plugin=PlayniteAchievements, Path=ModernTheme.AchievementCount, FallbackValue=1}" Value="{PluginSettings Plugin=PlayniteAchievements, Path=ModernTheme.UnlockedCount, FallbackValue=0}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBackgroundBrush}" IsHitTestVisible="False" />
            </StackPanel>
        </Grid>
        <ToggleButton x:Name="DuneAchievementsToggle" IsChecked="{Binding IsSelected, ElementName=DuneAchievementsDetails, Mode=TwoWay}" Tag="{Binding Visibility, ElementName=DuneAchievementsDetails}" Style="{StaticResource DuneCardToggle}" AutomationProperties.Name="{DynamicResource LOCDuneAchievements}" />
    </Grid>
    <Grid x:Name="DuneCatalogSummary" Style="{StaticResource DuneCatalogLayout}" Tag="{PluginSettings Plugin=CheckDlc, Path=ListDlcs}">
        <Grid.Resources>
            <!-- Bridge plugin data through the visual root: direct PluginSettings expressions on template resources are not shareable. -->
            <CollectionViewSource x:Key="DuneDlcOwnership" Source="{Binding Tag, ElementName=DuneCatalogSummary}">
                <CollectionViewSource.SortDescriptions>
                    <scm:SortDescription xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase" PropertyName="IsOwned" Direction="Descending" />
                </CollectionViewSource.SortDescriptions>
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="IsOwned" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="DuneCatalogBreakpoint" Grid.ColumnSpan="2" Width="600" Height="0" MaxWidth="{Binding ActualWidth, ElementName=DuneCatalogSummary}" HorizontalAlignment="Left" IsHitTestVisible="False" />
        <Grid x:Name="DuneLanguagesSummary" Tag="{DynamicResource DuneShowLanguagesSummary}" ToolTip="{DynamicResource LOCDunePreferredLanguageHint}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="MinHeight" Value="120" />
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{PluginSettings Plugin=CheckLocalizations, Path=HasData, FallbackValue=False}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{PluginSettings Plugin=CheckLocalizations, Path=ListNativeSupport.Count, FallbackValue=0}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Visibility, ElementName=DuneDlcSummary}" Value="Visible" />
                                <Condition Binding="{Binding ActualWidth, ElementName=DuneCatalogBreakpoint}" Value="600" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=DuneLanguagesSummary}" Value="Collapsed">
                            <Setter Property="Grid.Row" Value="0" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Visibility, ElementName=DuneDlcSummary}" Value="Visible" />
                                <Condition Binding="{Binding ActualWidth, ElementName=DuneWideBreakpoint}" Value="1320" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=DuneLanguagesToggle}" Value="Visible">
                            <Setter Property="Cursor" Value="Hand" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource DetailViewCardBorder}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True" />
                                    <Condition Binding="{Binding Visibility, ElementName=DuneLanguagesToggle}" Value="Visible" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="0.1" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="DuneLanguagesCatalogHeading">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="" Style="{StaticResource IconFontStyle}" FontSize="20" HorizontalAlignment="Left" />
                    <Label Grid.Column="2" Content="{DynamicResource LOCDuneLanguages}" Margin="0" FontSize="12" FontWeight="Normal">
                        <Label.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextBrushDarker}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </Label.ContentTemplate>
                    </Label>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" IsHitTestVisible="False">
                        <ContentControl x:Name="DuneLanguagesCatalogProviderIcon" Tag="{Binding Text, ElementName=DuneLanguagesIconPath}" Content="" Style="{StaticResource DuneLocalPluginIcon}"></ContentControl>
                        <TextBlock Text="" Style="{StaticResource IconFontStyle}" Width="12" FontSize="12" Foreground="{DynamicResource TextBrushDarker}" Visibility="{Binding Visibility, ElementName=DuneLanguagesToggle}" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="DuneLanguagesCatalogValue" Grid.Row="2" MinHeight="28" VerticalAlignment="Top">
                    <TextBlock x:Name="DunePreferredLanguageStatus" ToolTip="{DynamicResource LOCDunePreferredLanguageHint}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DuneSummaryPrimaryText}">
                                <Setter Property="Text" Value="{DynamicResource LOCDuneLanguageDetails}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{PluginSettings Plugin=CheckLocalizations, Path=HasNativeSupport, FallbackValue=Unknown}" Value="False">
                                        <Setter Property="Text" Value="{DynamicResource LOCDunePreferredLanguageMissing}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{PluginSettings Plugin=CheckLocalizations, Path=HasNativeSupport, FallbackValue=Unknown}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource LOCDunePreferredLanguageListed}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DuneLanguageCount" Text="{PluginSettings Plugin=CheckLocalizations, Path=ListNativeSupport.Count, FallbackValue=0}" Style="{StaticResource DuneSummarySecondaryText}" />
                        <TextBlock Text="{DynamicResource LOCDuneLanguagesRecorded}" Margin="6,0,0,0" Style="{StaticResource DuneSummarySecondaryText}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <ToggleButton x:Name="DuneLanguagesToggle" IsChecked="{Binding IsSelected, ElementName=DuneLanguagesDetails, Mode=TwoWay}" Tag="{Binding Visibility, ElementName=DuneLanguagesDetails}" Style="{StaticResource DuneCardToggle}" AutomationProperties.Name="{DynamicResource LOCDuneLanguages}" />
        </Grid>
        <Grid x:Name="DuneDlcSummary" Tag="{DynamicResource DuneShowDlcSummary}" ToolTip="{DynamicResource LOCDuneDlcCatalogHint}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="MinHeight" Value="120" />
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{PluginSettings Plugin=CheckDlc, Path=HasData, FallbackValue=False}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{PluginSettings Plugin=CheckDlc, Path=ListDlcs.Count, FallbackValue=0}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Visibility, ElementName=DuneLanguagesSummary}" Value="Visible" />
                                <Condition Binding="{Binding ActualWidth, ElementName=DuneCatalogBreakpoint}" Value="600" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.Column" Value="1" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=DuneLanguagesSummary}" Value="Collapsed">
                            <Setter Property="Grid.Row" Value="0" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Visibility, ElementName=DuneLanguagesSummary}" Value="Visible" />
                                <Condition Binding="{Binding ActualWidth, ElementName=DuneWideBreakpoint}" Value="1320" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.Column" Value="1" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=DuneDlcToggle}" Value="Visible">
                            <Setter Property="Cursor" Value="Hand" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource DetailViewCardBorder}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True" />
                                    <Condition Binding="{Binding Visibility, ElementName=DuneDlcToggle}" Value="Visible" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="0.1" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="DuneDlcCatalogHeading">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="" Style="{StaticResource IconFontStyle}" FontSize="20" HorizontalAlignment="Left" />
                    <Label Grid.Column="2" Content="{DynamicResource LOCDuneDlcCatalog}" Margin="0" FontSize="12" FontWeight="Normal">
                        <Label.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextBrushDarker}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </Label.ContentTemplate>
                    </Label>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" IsHitTestVisible="False">
                        <TextBlock x:Name="DuneDlcCatalogProviderIcon" Text="">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DuneSummaryProviderGlyph}">
                                    <Style.Triggers></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="" Style="{StaticResource IconFontStyle}" Width="12" FontSize="12" Foreground="{DynamicResource TextBrushDarker}" Visibility="{Binding Visibility, ElementName=DuneDlcToggle}" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="DuneDlcCatalogValue" Grid.Row="2" MinHeight="28" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DuneDlcCount" Text="{PluginSettings Plugin=CheckDlc, Path=ListDlcs.Count, FallbackValue=0}" Style="{StaticResource DuneSummaryPrimaryText}" />
                        <TextBlock Text="{DynamicResource LOCDuneDlcItems}" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource DuneSummarySecondaryText}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Top">
                    <ItemsControl x:Name="DuneDlcOwnershipCounts" ItemsSource="{Binding Groups, Source={StaticResource DuneDlcOwnership}}" Margin="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <TextBlock Margin="0,0,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DuneSummarySecondaryText}">
                                                <Setter Property="Text" Value="{DynamicResource LOCDuneDlcNotOwned}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="True">
                                                        <Setter Property="Text" Value="{DynamicResource LOCDuneDlcOwned}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ItemCount}" Style="{StaticResource DuneSummarySecondaryText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
            <ToggleButton x:Name="DuneDlcToggle" IsChecked="{Binding IsSelected, ElementName=DuneDlcDetails, Mode=TwoWay}" Tag="{Binding Visibility, ElementName=DuneDlcDetails}" Style="{StaticResource DuneCardToggle}" AutomationProperties.Name="{DynamicResource LOCDuneDlc}" />
        </Grid>
    </Grid>
</SummaryCards>