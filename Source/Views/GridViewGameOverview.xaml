<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border Padding="0" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <DockPanel MinWidth="300">

                            <Grid DockPanel.Dock="Top">

                                <DockPanel>
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <Trigger Property="DataContext" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>

                                    <Grid Margin="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.RowSpan="2">
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.Row="0"
                                                    Style="{DynamicResource DetailsScrollViewer}" d:DesignWidth="1280" d:DesignHeight="1280"
                                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}" x:Name="PART_ScrollViewHost">

                                                <Grid MinWidth="300" Margin="24,0,24,0" x:Name="DuneGridPage">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*" />
                                                        <ColumnDefinition MaxWidth="320">
                                                            <ColumnDefinition.Style>
                                                                <Style TargetType="ColumnDefinition">
                                                                    <Setter Property="Width" Value="0" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ActualWidth, ElementName=DuneGridBodyBreakpoint}" Value="900">
                                                                            <Setter Property="Width" Value="*" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ColumnDefinition.Style>
                                                        </ColumnDefinition>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Margin="0,0,0,24" Grid.ColumnSpan="2" Grid.Row="0" x:Name="DuneGridHeroFrame" Background="{DynamicResource ControlShadeBrush}" MinHeight="320">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.Resources>
                                                            <VisualBrush x:Key="ClonedVisualBrush" Visual="{Binding ElementName=PART_ImageBackground}" />
                                                        </Grid.Resources>
                                                        <Grid.OpacityMask>
                                                                <VisualBrush>
                                                                    <VisualBrush.Visual>
                                                                        <Border Background="Black" CornerRadius="{DynamicResource ControlCornerRadiusLargeX}" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Grid.OpacityMask>
<Grid x:Name="HeroBanner">
                                                            <Border x:Name="DuneCompactPreference" Tag="{DynamicResource DuneCompactLayout}" Visibility="Collapsed" />

                                                            <!-- Size media from the pane width, independently of the full details page. -->
                                                            <Viewbox x:Name="DuneGridHeroAspect" Stretch="Uniform">
                                                                <Grid Width="1600">
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Setter Property="Height" Value="{DynamicResource DuneGridHeroDesignHeight}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Tag, ElementName=DuneCompactPreference}" Value="True"><Setter Property="Height" Value="600" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <!--Game background image-->
                                                                    <Grid x:Name="NativeBackgroundLayer" ClipToBounds="True">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=HasDataBackground, FallbackValue=False}" Value="True" />
                                                                                            <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=EnableBackgroundImage, FallbackValue=False}" Value="True" />
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <!--Blurred Layer-->
                                                                        <Rectangle Fill="{DynamicResource ClonedVisualBrush}">
                                                                            <Rectangle.Effect>
                                                                                <BlurEffect Radius="{DynamicResource DuneHeroBlurRadius}" />
                                                                            </Rectangle.Effect>
                                                                        </Rectangle>
                                                                        <!--Gradient Layer-->
                                                                        <Grid>
                                                                            <Grid.OpacityMask>
                                                                                <RadialGradientBrush GradientOrigin="0.5,1" Center="0.5,1" RadiusX="1.2" RadiusY="0.6">
                                                                                    <RadialGradientBrush.GradientStops>
                                                                                        <GradientStop Color="#00FFFFFF" Offset="0.4" />
                                                                                        <GradientStop Color="White" Offset="0.6" />
                                                                                    </RadialGradientBrush.GradientStops>
                                                                                </RadialGradientBrush>
                                                                            </Grid.OpacityMask>
                                                                            <FadeImage x:Name="PART_ImageBackground" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FlowDirection="LeftToRight" />
                                                                        </Grid>
                                                                    </Grid>
                                                                    <Grid x:Name="BackgroundChangerLayer" ClipToBounds="True" IsHitTestVisible="False">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=HasDataBackground, FallbackValue=False}" Value="True" />
                                                                                            <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=EnableBackgroundImage, FallbackValue=False}" Value="True" />
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <ContentControl x:Name="BackgroundChanger_PluginBackgroundImage" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                                    </Grid>
                                                                    <!--Game background image Ends-->
                                                                    <!--Game video-->
                                                                    <Grid x:Name="GameVideo">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ElementName=VideoThumbnail, Path=IsChecked}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding ElementName=ImageThumbnail, Path=IsChecked}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoSource, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <Rectangle>
                                                                            <Rectangle.Fill>
                                                                                <VisualBrush Visual="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl}" Stretch="Uniform" />
                                                                            </Rectangle.Fill>
                                                                        </Rectangle>
                                                                    </Grid>
                                                                    <!--Game video Ends-->
                                                                    <!--Daken Layer-->
                                                                    <Border Background="Black" Opacity="{DynamicResource DuneHeroShadeOpacity}">
                                                                        <Border.OpacityMask>
                                                                            <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                                                                <GradientStop Color="White" Offset="0" />
                                                                                <GradientStop Color="Transparent" Offset="0.5" />
                                                                            </LinearGradientBrush>
                                                                        </Border.OpacityMask>
                                                                    </Border>
                                                                </Grid>
                                                            </Viewbox>
                                                        </Grid>
                                                        <!--Extra Logo-->
                                                        <Grid Margin="24,24,72,24" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                                            <Border x:Name="GameIcon" HorizontalAlignment="Left" CornerRadius="{StaticResource ControlCornerRadius}" Tag="{DynamicResource GridViewAllowUseOfLogos}">
                                                                <Image Name="PART_ImageIcon" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" MaxHeight="72" MaxWidth="72" />
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="false">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <Border x:Name="ExtraMetadataLoader_LogoLoaderControlGrid" VerticalAlignment="Center" HorizontalAlignment="Left" Tag="{DynamicResource GridViewAllowUseOfLogos}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="false">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl" MaxHeight="{DynamicResource DuneGridLogoMaxHeight}" MaxWidth="{DynamicResource DuneGridLogoMaxWidth}" />
                                                            </Border>
                                                        </Grid>
                                                        <!--Extra Logo Ends-->
                                                        <Grid Grid.Row="0" x:Name="DuneGridHeroFooter" Style="{StaticResource DuneGridHeroFooter}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <!-- Put media beside the actions as soon as both fit.
                                                                 On narrow panes media precedes the actions, so
                                                                 the game information always anchors the bottom. -->
                                                            <Border x:Name="DuneHeroFooterBreakpoint" Width="720" Height="0" MaxWidth="{Binding ActualWidth, ElementName=DuneGridHeroFooter}" HorizontalAlignment="Left" IsHitTestVisible="False" Grid.ColumnSpan="2" />
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
  <StackPanel.Style>
    <Style TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
<Setter Property="Margin" Value="0,0,0,12" />
<Setter Property="VerticalAlignment" Value="Bottom" />
      <Style.Triggers><DataTrigger Binding="{Binding ActualWidth, ElementName=DuneHeroFooterBreakpoint}" Value="720">
    <Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.RowSpan" Value="2" />
    <Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="Margin" Value="16,0,0,0" />
</DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableVideoPlayer, FallbackValue=False}" Value="True" />
            <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsAnyVideoAvailable, FallbackValue=False}" Value="True" />
            <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableAlternativeGridVideoPlayer, FallbackValue=False}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Visible" />
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoSource, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </StackPanel.Style>
  <StackPanel Name="VideoControlButton" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
    <StackPanel.Style>
      <Style TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsAnyVideoAvailable, FallbackValue=False}" Value="True" />
              <Condition Binding="{Binding ElementName=VideoThumbnail, Path=IsChecked}" Value="True" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Visibility" Value="Visible" />
          </MultiDataTrigger>
          <DataTrigger Binding="{Binding ElementName=ImageThumbnail, Path=IsChecked}" Value="True">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
          <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoSource, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </StackPanel.Style>
    <ToggleButton HorizontalAlignment="Left" x:Name="TrailerPauseButton" Tag="&#xE103;" Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoPauseCommand, FallbackValue={x:Null}}" Visibility="{Binding ElementName=TrailerPlayButton, Path=IsEnabled, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" Style="{DynamicResource IconRoundedToggleButton}"></ToggleButton>
    <ToggleButton HorizontalAlignment="Left" x:Name="TrailerPlayButton" Tag="&#xE102;" Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoPlayCommand, FallbackValue={x:Null}}" Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{DynamicResource IconRoundedToggleButton}"></ToggleButton>
    <CheckBox Margin="8,0,0,0" IsChecked="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.IsPlayerMuted, Mode=TwoWay, FallbackValue={StaticResource True}}">
      <CheckBox.Template>
        <ControlTemplate TargetType="CheckBox">
          <Border Name="Border" BorderThickness="1" BorderBrush="#33FFFFFF" Background="#33000000" Width="36" Height="36" CornerRadius="18">
            <TextBlock x:Name="NotMuted" Text="&#xE198;" Style="{StaticResource IconFontStyle}" Margin="8" Foreground="White" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Text" TargetName="NotMuted" Value="&#xE994;" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#66000000" TargetName="Border" />
              <Setter Property="BorderBrush" Value="#66FFFFFF" TargetName="Border" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </CheckBox.Template>
    </CheckBox>
  </StackPanel>
  <!--Image Thumbnail-->
  <Grid Width="80" Height="45">
    <Grid Margin="4">
      <Grid.OpacityMask>
        <VisualBrush>
          <VisualBrush.Visual>
            <Border Background="Black" CornerRadius="{DynamicResource ControlCornerRadius}" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
          </VisualBrush.Visual>
        </VisualBrush>
      </Grid.OpacityMask>
      <Rectangle>
        <Rectangle.Fill>
          <VisualBrush Visual="{Binding ElementName=PART_ImageBackground}" Stretch="UniformToFill" />
        </Rectangle.Fill>
      </Rectangle>
    </Grid>
    <Border Background="Transparent" BorderBrush="White" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" Visibility="{Binding ElementName=ImageThumbnail, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <RadioButton Name="ImageThumbnail" GroupName="GridHeroMedia" Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoPauseCommand}" Style="{DynamicResource TransparentRadioButton}" />
  </Grid>
  <!--Video Thumbnail-->
  <Grid Margin="8,0,0,0" Width="80" Height="45">
    <Grid Margin="4">
      <Grid.OpacityMask>
        <VisualBrush>
          <VisualBrush.Visual>
            <Border Background="Black" CornerRadius="{DynamicResource ControlCornerRadius}" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
          </VisualBrush.Visual>
        </VisualBrush>
      </Grid.OpacityMask>
      <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControl">
        <!-- EML's standard player initializes the active view; the configured
             NoControls variant in 1.87 skips Grid game contexts. Scope this
             override to the native control strip inside this player only. -->
        <ContentControl.Resources>
          <Style TargetType="{x:Type WrapPanel}">
            <Setter Property="MaxHeight" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
          </Style>
        </ContentControl.Resources>
        <ContentControl.Template>
          <ControlTemplate TargetType="ContentControl">
            <Viewbox Stretch="Uniform" VerticalAlignment="Center">
              <Grid>
                <ContentPresenter />
                <Border Background="Transparent" />
              </Grid>
            </Viewbox>
          </ControlTemplate>
        </ContentControl.Template>
      </ContentControl>
    </Grid>
    <Border Background="#99000000" BorderBrush="#33FFFFFF" BorderThickness="1" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Viewbox Name="ThumbnailPlay" Margin="13,12,11,12">
        <TextBlock Text="&#xF5B0;" Foreground="White" Style="{StaticResource IconFontStyle}" />
      </Viewbox>
    </Border>
    <Border Background="Transparent" BorderBrush="White" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" Visibility="{Binding ElementName=VideoThumbnail, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <RadioButton Name="VideoThumbnail" GroupName="GridHeroMedia" IsChecked="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.SettingsModel.Settings.IsVideoPlaying, Mode=OneWay, FallbackValue={StaticResource False}}" Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoPlayCommand}" Style="{DynamicResource TransparentRadioButton}" />
  </Grid>
</StackPanel>
                                                            <!--GameInfo-->
                                                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,10,0,0"><WrapPanel.Style><Style TargetType="WrapPanel">
        <Setter Property="Grid.Row" Value="2" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Style.Triggers><DataTrigger Binding="{Binding ActualWidth, ElementName=DuneHeroFooterBreakpoint}" Value="720">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
        </DataTrigger></Style.Triggers>
    </Style></WrapPanel.Style>
                                                                <Button Name="PART_ButtonReleaseDate" Margin="0,0,4,0" Padding="0" BorderThickness="0" Background="{x:Null}" VerticalAlignment="Center" Style="{DynamicResource PropertyItemSmallButton}" />
                                                                <StackPanel Name="PART_ElemPlatform" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Settings DetailsVisibility.Platforms}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Game.Platforms}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBlock Text="·" Margin="4,0" Foreground="#99FFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
                                                                    <ItemsControl ItemsSource="{Binding Game.Platforms}" Margin="0" VerticalAlignment="Center">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Button Content="{Binding Name}" Margin="4,0" Padding="0" BorderThickness="0" Background="{x:Null}" VerticalAlignment="Center" Style="{DynamicResource PropertyItemSmallButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=DataContext.SetPlatformFilterCommand}" CommandParameter="{Binding}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <Button Name="PART_ButtonSource" Margin="4,0" Padding="0" VerticalAlignment="Center" Style="{DynamicResource PropertyItemOutlinedButton}" />
                                                                <ContentControl x:Name="DuplicateHider_SourceSelector" Height="24" Margin="8,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                                                <ContentControl x:Name="NewsViewer_PlayersInGameViewerControl" Margin="8,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                                                <StackPanel Name="PART_ElemGenres" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Settings DetailsVisibility.Genres}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Game.Genres}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <ItemsControl ItemsSource="{Binding Game.Genres}" Margin="0" VerticalAlignment="Center">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Button Content="{Binding Name}" Margin="4,0" Padding="0" VerticalAlignment="Center" Style="{DynamicResource PropertyItemOutlinedButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=DataContext.SetPlatformFilterCommand}" CommandParameter="{Binding}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </WrapPanel>
                                                            <!-- Primary command followed by compact edit and favorite actions. -->
                                                            <Grid x:Name="DuneGridActionSlot">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Setter Property="Grid.Row" Value="1" />
                                                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ActualWidth, ElementName=DuneHeroFooterBreakpoint}" Value="720">
                                                                                <Setter Property="Grid.Row" Value="0" />
                                                                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                            <Grid x:Name="DuneGameActions" HorizontalAlignment="Left" MinWidth="252" Width="{DynamicResource GameActionButtonWidth}" MaxWidth="{Binding ActualWidth, ElementName=DuneGridActionSlot}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid Grid.Column="0">
                                                                    <Button Name="PART_ButtonPlayAction" Style="{DynamicResource DetailPlayButton}" />
                                                                    <Button Name="PART_ButtonContextAction" Style="{DynamicResource DetailPlayButton}" />
                                                                    <Button Name="PART_ButtonMoreActions" HorizontalAlignment="Right" Content="&#xE228;" Style="{DynamicResource DetailPlayButtonRightPart}" />
                                                                </Grid>
