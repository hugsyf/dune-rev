                                                                                        <Grid x:Name="DuneActivityPerformance" Visibility="{PluginSettings Plugin=GameActivity, Path=HasDataLog, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                            <StackPanel Visibility="{Binding Visibility, ElementName=GameActivity_PluginChartLog}">
                                                                                                <DockPanel Margin="0,0,0,8">
                                                                                                    <Grid DockPanel.Dock="Right" Tag="{PluginSettings Plugin=GameActivity, Path=AvgFpsAllSession, FallbackValue=0}" Style="{StaticResource DunePositiveSummaryValue}">
                                                                                                        <TextBlock Style="{StaticResource DuneSummarySecondaryText}">
                                                                                                            <Run Text="{DynamicResource LOCDuneAverageFps}" />
                                                                                                            <Run Text=" : " />
                                                                                                            <Run Text="{PluginSettings Plugin=GameActivity, Path=AvgFpsAllSession, FallbackValue=''}" />
                                                                                                        </TextBlock>
                                                                                                    </Grid>
                                                                                                    <TextBlock Text="{DynamicResource LOCDunePerformanceHistory}" FontWeight="SemiBold" />
                                                                                                </DockPanel>
                                                                                                <ContentControl x:Name="GameActivity_PluginChartLog" Style="{StaticResource DunePluginContent}" Margin="0" />
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                    </StackPanel>
                                                                                </ScrollViewer>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Grid>
                                                                </Grid>
                                                                <TabControl x:Name="DuneOverviewTabs" Style="{StaticResource DetailViewTabControl}">
                                                                    <TabItem x:Name="DescriptionTab" Header="{DynamicResource LOCOverviewLabel}">
                                                                        <StackPanel Margin="0,24,0,0">
                                                                            <StackPanel x:Name="DescriptionContent" Margin="0,0,0,0">
                                                                                <StackPanel Name="PART_ElemDescription">
                                                                                    <HtmlTextView Name="PART_HtmlDescription" Margin="0,0,0,0" HorizontalAlignment="Stretch" HtmlFontSize="{DynamicResource FontSize}" HtmlFontFamily="{DynamicResource FontFamily}" LinkForeground="{DynamicResource AccentSelectedColor}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">
                                                                                        <HtmlTextView.Style>
                                                                                            <Style TargetType="HtmlTextView">
                                                                                                <Setter Property="HtmlForeground" Value="{DynamicResource PrimaryTextColor}" />
                                                                                            </Style>
                                                                                        </HtmlTextView.Style>
                                                                                    </HtmlTextView>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                            <Expander Header="{DynamicResource LOCNotesLabel}" Margin="0,24,0,0" Visibility="{Binding ElementName=NotesVisibilityProxy, Path=Tag}">
                                                                                <StackPanel>
                                                                                    <StackPanel Margin="0,24,0,0">
                                                                                        <TextBlock x:Name="NotesVisibilityProxy" Visibility="Collapsed">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Tag" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding ElementName=PART_TextNotes, Path=Visibility}" Value="Visible">
                                                                                                            <Setter Property="Tag" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <TextBox Name="PART_TextNotes" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                            </Expander>
                                                                            <Expander Header="{DynamicResource LOCDunePlayNotes}" Margin="0,24,0,0" Tag="{DynamicResource DuneShowPlayNotes}">
                                                                                <Expander.Style>
                                                                                    <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <MultiDataTrigger>
                                                                                                <MultiDataTrigger.Conditions>
                                                                                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                                                    <Condition Binding="{PluginSettings Plugin=PlayNotes, Path=IsControlVisible, FallbackValue=False}" Value="True" />
                                                                                                </MultiDataTrigger.Conditions>
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </MultiDataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Expander.Style>
                                                                                <Border Style="{StaticResource DunePluginPanel}">
                                                                                    <ContentControl x:Name="PlayNotes_NotesViewerControl" Style="{StaticResource DunePluginContent}" />
                                                                                </Border>
                                                                            </Expander>
                                                                            <Expander Header="{DynamicResource LOCSsvTitle}" Margin="0,24,0,0" Visibility="{PluginSettings Plugin=ScreenshotsVisualizer, Path=HasData, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <StackPanel>
                                                                                    <Border Style="{DynamicResource DunePluginPanel}">
                                                                                        <StackPanel Orientation="Vertical">
                                                                                            <ContentControl x:Name="ScreenshotsVisualizer_PluginListScreenshotsVertical" Height="{DynamicResource ScreenshotsPanelHeight}" Style="{DynamicResource DunePluginContent}" />
                                                                                            <ContentControl x:Name="ScreenshotsVisualizer_PluginSinglePicture" Style="{DynamicResource DunePluginContent}" />
                                                                                            <ContentControl x:Name="ScreenshotsVisualizer_PluginListScreenshots" Style="{DynamicResource DunePluginContent}" />
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                            </Expander>
                                                                        </StackPanel>
                                                                    </TabItem>
                                                                    <TabItem Header="{DynamicResource LOCDuneRelatedGames}" Tag="{DynamicResource DuneShowRelations}">
                                                                        <TabItem.Style>
                                                                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                                            <Condition Binding="{PluginSettings Plugin=GameRelations, Path=SameSeriesControlSettings.IsVisible, FallbackValue=False}" Value="True" />
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </MultiDataTrigger>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                                            <Condition Binding="{PluginSettings Plugin=GameRelations, Path=SimilarGamesControlSettings.IsVisible, FallbackValue=False}" Value="True" />
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TabItem.Style>
                                                                        <StackPanel Margin="0,24,0,0">
                                                                            <StackPanel Visibility="{PluginSettings Plugin=GameRelations, Path=SameSeriesControlSettings.IsVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <TextBlock Text="{DynamicResource LOCDuneSameSeries}" FontWeight="SemiBold" />
                                                                                <Border Style="{StaticResource DunePluginPanel}">
                                                                                    <ContentControl x:Name="GameRelations_SameSeriesControl" Height="{DynamicResource DuneRelationsPanelHeight}" Style="{StaticResource DunePluginContent}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <StackPanel Visibility="{PluginSettings Plugin=GameRelations, Path=SimilarGamesControlSettings.IsVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <TextBlock Text="{DynamicResource LOCDuneSimilarGames}" FontWeight="SemiBold" />
                                                                                <Border Style="{StaticResource DunePluginPanel}">
                                                                                    <ContentControl x:Name="GameRelations_SimilarGamesControl" Height="{DynamicResource DuneRelationsPanelHeight}" Style="{StaticResource DunePluginContent}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </TabItem>
                                                                    <TabItem Header="{DynamicResource LOCReview_Viewer_ReviewsLabel}" Visibility="{PluginSettings Plugin=ReviewViewer, Path=IsControlVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="16" x:Name="DuneReviewsDetails">
                                                                        <StackPanel>
                                                                            <Border Style="{DynamicResource DunePluginPanel}">
                                                                                <ContentControl x:Name="ReviewViewer_ReviewsControl" Foreground="{DynamicResource TextBrush}" TextElement.Foreground="{DynamicResource TextBrush}" Style="{DynamicResource DunePluginContent}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </TabItem>
                                                                    <TabItem Header="{DynamicResource LOC_NewsViewer_NewsViewerControl_NewsLabel}" Visibility="{PluginSettings Plugin=NewsViewer, Path=ReviewsAvailable, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="16" x:Name="DuneNewsDetails">
                                                                        <StackPanel>
                                                                            <Border Style="{DynamicResource DunePluginPanel}">
                                                                                <ContentControl x:Name="NewsViewer_NewsViewerControl" Style="{DynamicResource DunePluginContent}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </TabItem>
                                                                </TabControl>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                    <Border Name="DuneGridBodyBreakpoint" Height="0" MaxWidth="900" Width="{Binding ActualWidth, ElementName=DuneGridPage}" Grid.ColumnSpan="2" IsHitTestVisible="False" />
                                                </Grid>
                                            </ScrollViewer>
                                        </Grid>

                                    </Grid>

                                </DockPanel>

                                <!--No Item Selected-->
                                <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" FontSize="{DynamicResource FontSizeLarge}"
                                           Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <Trigger Property="DataContext" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
