<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style x:Key="FilterPanelCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="16,2,16,8" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="{StaticResource False}">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="FilterPanelLabel" TargetType="Label">
        <Setter Property="Margin" Value="16,12,16,4" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    
    <Style x:Key="FilterPanelFilterSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>
    
    <Style x:Key="FilterPanelFilterSelectionBox" TargetType="FilterSelectionBox" BasedOn="{StaticResource {x:Type FilterSelectionBox}}">
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>
    
    <Style x:Key="FilterPanelFilterEnumSelectionBox" TargetType="FilterEnumSelectionBox" BasedOn="{StaticResource {x:Type FilterEnumSelectionBox}}">
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>
    
    <Style x:Key="FilterPanelFilterStringSelectionBox" TargetType="FilterStringSelectionBox" BasedOn="{StaticResource {x:Type FilterStringSelectionBox}}">
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <Style x:Key="FilterPresetButtonAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>

    <Style TargetType="{x:Type FilterPanel}">  
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPanel}">
                    <Border Uid="Dune.Material.Panel" Tag="{DynamicResource DuneMaterialsEnabled}" BorderBrush="{DynamicResource DuneSurfaceEdgeBrush}" BorderThickness="1" CornerRadius="12" Margin="8,0,8,8"
                            d:DesignWidth="200">
                        <Border.Background>
                            <PriorityBinding>
                                <Binding RelativeSource="{RelativeSource Self}" Converter="{PluginConverter Plugin=DuneMaterials, Converter=MaterialBrushConverter}" ConverterParameter="TemplateBackground" />
                                <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}" />
                            </PriorityBinding>
                        </Border.Background>

                        <DockPanel Background="Transparent">
                            <!--Row 1-->
                            <DockPanel Margin="16,16,16,0" DockPanel.Dock="Top">
                                <Button Name="PART_ButtonClose" DockPanel.Dock="Right" 
                                        Content="&#xe106;" 
                                        FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Top" Margin="0,0,0,0"
                                        Style="{StaticResource DuneIconActionButton}" Width="28" Height="28"/>
                                <Button Name="PART_ButtonClear" DockPanel.Dock="Left" Height="32" Padding="8,0" Background="Transparent" BorderThickness="0"
                                        Content="{StaticResource LOCClearFilters}" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="0"
                                        Style="{StaticResource DuneSecondaryButton}" Template="{DynamicResource DunePluginActionButtonTemplate}"/>
                            </DockPanel>
                            <!--Row 2-->
                            <DockPanel Margin="16,16,16,0" DockPanel.Dock="Top">
                                <Button x:Name="PART_ButtonDeleteFilter"
                                        Content="&#xe107;" Style="{DynamicResource FilterPresetButtonAction}" />
                                <Button x:Name="PART_ButtonRenameFilter" Margin="4,0,4,0"
                                        Content="&#xe104;" Style="{DynamicResource FilterPresetButtonAction}"/>
                                <Button x:Name="PART_ButtonSaveFilter"
                                        Content="&#xe105;" Style="{DynamicResource FilterPresetButtonAction}" />
                                <ComboBox x:Name="PART_ComboFilterPresets" Margin="0,0,4,0" 
                                          DockPanel.Dock="Left" VerticalAlignment="Center" />
                            </DockPanel>
                            <Separator Height="1" DockPanel.Dock="Top" Background="{DynamicResource PanelSeparatorBrush}" Margin="16,16,16,0" Focusable="False"
                                    SnapsToDevicePixels="True" />
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      DockPanel.Dock="Top">
                                <StackPanel x:Name="PART_PanelItemsHost" Margin="0,16,0,16"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>                                                       
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
