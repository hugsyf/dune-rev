                                                                    <ContentControl x:Name="CheckDlc_PluginListDlcNotOwned" Style="{DynamicResource DunePluginContent}" Height="{DynamicResource DuneDlcPanelHeight}" Margin="0,8,0,0" Tag="{Binding Content.DataContext.ItemsSource.Count, RelativeSource={RelativeSource Self}, FallbackValue=-1}" />
                                                                    <TextBlock Text="{DynamicResource LOCDuneEmptyDlcCategory}" Margin="0,24,0,0" VerticalAlignment="Top">
