                                                </TabItem>

                                            </TabControl>
                                        </StackPanel>
                                        <!--Tab Table Ends-->

                                    </StackPanel>
                                    <!--Left Side Ends-->

                                </Grid>
                            </ScrollViewer>
                        </Grid>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
