                                                                                    <DataTrigger Binding="{Binding Tag, ElementName=CheckDlc_PluginListDlcOwned}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </TabItem>
                                                            <TabItem Header="{DynamicResource LOCDuneDlcNotOwned}" Visibility="{Binding Visibility, ElementName=CheckDlc_PluginListDlcNotOwned}">
