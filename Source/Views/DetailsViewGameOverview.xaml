                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DuneSummarySecondaryText}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Tag, ElementName=CheckDlc_PluginListDlcNotOwned}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </TabItem>
                                                        </TabControl>
                                                    </Border>
                                                </TabItem>
                                                <TabItem Header="HowLongToBeat" Visibility="{PluginSettings Plugin=HowLongToBeat, Path=HasData, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="16">
                                                  <Border Style="{DynamicResource DunePluginPanel}">
                                                    <StackPanel>
                                                      <ContentControl x:Name="HowLongToBeat_PluginProgressBar" Style="{DynamicResource DunePluginContent}" />
                                                    </StackPanel>
                                                  </Border>
                                                </TabItem>

                                                <TabItem Header="{DynamicResource LOCGameActivityTitle}" Visibility="{PluginSettings Plugin=GameActivity, Path=HasData, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="16">
                                                  <Border Style="{DynamicResource DunePluginPanel}">
                                                    <StackPanel>
                                                      <ContentControl x:Name="GameActivity_PluginChartTime" Style="{DynamicResource DunePluginContent}" />
                                                    </StackPanel>
                                                  </Border>
                                                </TabItem>

                                                <TabItem Header="{DynamicResource LOCReview_Viewer_ReviewsLabel}" Visibility="{PluginSettings Plugin=ReviewViewer, Path=IsControlVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="16">
                                                  <Border Style="{DynamicResource DunePluginPanel}">
                                                    <ContentControl x:Name="ReviewViewer_ReviewsControl" Foreground="{DynamicResource TextBrush}" TextElement.Foreground="{DynamicResource TextBrush}" Style="{DynamicResource DunePluginContent}"></ContentControl>
                                                  </Border>
                                                </TabItem>

                                                <TabItem Header="{DynamicResource LOC_NewsViewer_NewsViewerControl_NewsLabel}" Visibility="{PluginSettings Plugin=NewsViewer, Path=ReviewsAvailable, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="16">
                                                  <Border Style="{DynamicResource DunePluginPanel}">
                                                    <ContentControl x:Name="NewsViewer_NewsViewerControl" Style="{DynamicResource DunePluginContent}" />
