                                                        <Button Name="PART_ButtonInstallDirectory" VerticalAlignment="Center" Margin="0,8,0,4" />
                                                        <TextBlock Name="PART_TextInstallSize" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}"/>
                                                    </StackPanel>
                                                    <!--Features-->
                                                    <StackPanel Name="PART_ElemFeatures">
                                                        <Separator Background="{StaticResource PanelSeparatorBrush}" Height="1" Margin="0,16,0,16" />
                                                        <TextBlock Text="{DynamicResource LOCFeaturesLabel}" FontWeight="Bold" />

                                                        <StackPanel Margin="0,8,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Settings DetailsVisibility.Features}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Game.Features}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <ItemsControl ItemsSource="{Binding Game.Features}" Margin="0,0,0,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding Name}" Margin="0,2,4,2" Style="{DynamicResource PropertyItemTagButton}"
                                                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=DataContext.SetFeatureFilterCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                    </StackPanel>
                                                    <!--Tags-->
                                                    <StackPanel Name="PART_ElemTags">
                                                        <Separator Background="{StaticResource PanelSeparatorBrush}" Height="1" Margin="0,16,0,16" />
                                                        <TextBlock Text="{DynamicResource LOCTagsLabel}" FontWeight="Bold" />

                                                        <StackPanel Margin="0,8,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Settings DetailsVisibility.Tags}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Game.Tags}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <ItemsControl ItemsSource="{Binding Game.Tags}" Margin="0,0,0,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding Name}" Margin="0,2,4,2" Style="{DynamicResource PropertyItemTagButton}"
                                                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=DataContext.SetFeatureFilterCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                        </StackPanel>

                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                        </StackPanel>
                                        <!--Details Panel Ends-->

                                    </StackPanel>
                                    <!--Right Side Ends-->

                                    <!--Left Side-->
                                    <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,0,24,0">

                                        <!--Tab Table-->
                                        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Stretch">

                                            <TabControl Margin="0,0,0,16" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                                        Style="{StaticResource DetailViewTabControl}">
                                                <!--Tab Overview-->
                                                <TabItem Header="{DynamicResource LOCOverviewLabel}" x:Name="DescriptionTab" FontSize="16" >

                                                    <StackPanel Margin="0,24,0,0">

                                                        <StackPanel x:Name="DescriptionContent" Margin="0,0,0,0">
                                                            <StackPanel Name="PART_ElemDescription">
                                                                <HtmlTextView Name="PART_HtmlDescription" Margin="0,0,0,0" HorizontalAlignment="Stretch"
                                                                        HtmlFontSize="{DynamicResource FontSize}" HtmlFontFamily="{DynamicResource FontFamily}"
                                                                        LinkForeground="{DynamicResource AccentSelectedColor}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                                    <HtmlTextView.Style>
                                                                        <Style TargetType="HtmlTextView">
                                                                            <Setter Property="HtmlForeground" Value="{DynamicResource PrimaryTextColor}" />

                                                                        </Style>
                                                                    </HtmlTextView.Style>
                                                                </HtmlTextView>
                                                            </StackPanel>
                                                        </StackPanel>


                                                    </StackPanel>
                                                </TabItem>
                                                <!--Tab Overview Ends-->

                                                <!--Tab Notes-->
                                                <TabItem Header="{DynamicResource LOCNotesLabel}" FontSize="16"
                                                         Visibility="{Binding ElementName=NotesVisibilityProxy, Path=Tag}">
                                                    <StackPanel Margin="0,24,0,0">
                                                        <TextBlock x:Name="NotesVisibilityProxy" Visibility="Collapsed">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Tag" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ElementName=PART_TextNotes, Path=Visibility}" Value="Visible">
                                                                            <Setter Property="Tag" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBox Name="PART_TextNotes" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </TabItem>
                                                <!--Tab Notes Ends-->

                                                <TabItem Header="{DynamicResource LOCSuccessStoryAchievements}"
                         Visibility="{PluginSettings Plugin=SuccessStory, Path=HasData, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Margin="0,24,0,0">
                                                        <ContentControl x:Name="SuccessStory_PluginCompactUnlocked" Margin="0,0,0,24" />
                                                        <ContentControl x:Name="SuccessStory_PluginCompactLocked" Margin="0,0,0,24" />
                                                        <ContentControl x:Name="SuccessStory_PluginUserStats" Margin="0,0,0,24" />
                                                        <ContentControl x:Name="SuccessStory_PluginList" Margin="0,0,0,24" MinHeight="{DynamicResource SuccessStoryPanelMinHeight}" />
                                                        <ContentControl x:Name="SuccessStory_PluginChart" Margin="0,0,0,24" />
                                                    </StackPanel>
                                                </TabItem>

                                                <TabItem Header="{DynamicResource LOCSsvTitle}"
                         Visibility="{PluginSettings Plugin=ScreenshotsVisualizer, Path=HasData, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Orientation="Vertical" Background="{TemplateBinding Background}" Margin="0,24,0,0">
                                                        <ContentControl x:Name="ScreenshotsVisualizer_PluginListScreenshotsVertical" Margin="0,0,0,0" Height="{DynamicResource ScreenshotsPanelHeight}"/>
                                                        <ContentControl x:Name="ScreenshotsVisualizer_PluginSinglePicture" />
                                                        <ContentControl x:Name="ScreenshotsVisualizer_PluginListScreenshots" />
                                                    </StackPanel>

                                                </TabItem>

                                                <TabItem Header="HowLongToBeat"
                                                         Visibility="{PluginSettings Plugin=HowLongToBeat, Path=HasData, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Margin="0,24,0,0">
                                                        <ContentControl x:Name="HowLongToBeat_PluginProgressBar" />
                                                    </StackPanel>
                                                </TabItem>

                                                <TabItem Header="{DynamicResource LOCGameActivityTitle}"
                                                         Visibility="{PluginSettings Plugin=GameActivity, Path=HasData, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Margin="0,24,0,0">
                                                        <ContentControl x:Name="GameActivity_PluginChartTime" />
                                                    </StackPanel>
                                                </TabItem>

                                                <TabItem Header="{DynamicResource LOCReview_Viewer_ReviewsLabel}"
                                                         Visibility="{PluginSettings Plugin=ReviewViewer, Path=IsControlVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ContentControl x:Name="ReviewViewer_ReviewsControl"
                                                                    Margin="0,24,0,0"
                                                                    Foreground="{DynamicResource TextBrush}"
                                                                    TextElement.Foreground="{DynamicResource TextBrush}">
                                                        <ContentControl.Resources>
                                                            <Style TargetType="UserControl">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
                                                            </Style>
                                                        </ContentControl.Resources>
                                                    </ContentControl>
                                                </TabItem>

                                                <TabItem Header="{DynamicResource LOC_NewsViewer_NewsViewerControl_NewsLabel}"
                                                         Visibility="{PluginSettings Plugin=NewsViewer, Path=ReviewsAvailable, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ContentControl x:Name="NewsViewer_NewsViewerControl" Margin="0,24,0,0" />
                                                </TabItem>

                                            </TabControl>
                                        </StackPanel>
                                        <!--Tab Table Ends-->

                                    </StackPanel>
                                    <!--Left Side Ends-->

                                </Grid>
                            </ScrollViewer>
                        </Grid>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
