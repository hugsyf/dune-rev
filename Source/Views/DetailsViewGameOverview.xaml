
    <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.RowSpan="2">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.Row="0"
                                      Style="{DynamicResource DetailsScrollViewer}"
                                      d:DesignWidth="1280"
                                      d:DesignHeight="1280"
                                      d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                      x:Name="PART_ScrollViewHost">

                                <Grid MaxWidth="{DynamicResource GameOverviewWidth}" MinWidth="300" Margin="24,0,24,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="*" MaxWidth="{DynamicResource GameDetailInfoWidth}"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Settings CalculatedGameDetailsIndentation}"/>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Margin="0,0,0,40" Grid.ColumnSpan="2" Grid.Row="0">
                                        <Grid.Resources>
                                            <VisualBrush x:Key="ClonedVisualBrush" Visual="{Binding ElementName=PART_ImageBackground}" />
                                        </Grid.Resources>

                                        <Grid x:Name="HeroBanner">
                                            <Grid.OpacityMask>
                                                <VisualBrush>
                                                    <VisualBrush.Visual>
                                                        <Border Background="Black" CornerRadius="{DynamicResource ControlCornerRadiusLargeX}"
                                                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Grid.OpacityMask>

                                            <!--Game background image-->
                                            <Grid x:Name="NativeBackgroundLayer" ClipToBounds="True">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=HasDataBackground, FallbackValue=False}" Value="True" />
                                                                    <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=EnableBackgroundImage, FallbackValue=False}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <!--Blurred Layer-->
                                                <Rectangle Fill="{DynamicResource ClonedVisualBrush}">
                                                    <Rectangle.Effect>
                                                        <BlurEffect Radius="120" />
                                                    </Rectangle.Effect>
                                                </Rectangle>

                                                <!--Gradient Layer-->
                                                <Grid>
                                                    <Grid.OpacityMask>
                                                        <RadialGradientBrush GradientOrigin="0.5,1" Center="0.5,1" RadiusX="1.2" RadiusY="0.6">
                                                            <RadialGradientBrush.GradientStops>
                                                                <GradientStop Color="#00FFFFFF" Offset="0.4" />
                                                                <GradientStop Color="White" Offset="0.6" />
                                                            </RadialGradientBrush.GradientStops>
                                                        </RadialGradientBrush>
                                                    </Grid.OpacityMask>
                                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FlowDirection="LeftToRight" />
                                                </Grid>
                                            </Grid>
                                            <Grid x:Name="BackgroundChangerLayer" ClipToBounds="True" IsHitTestVisible="False">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=HasDataBackground, FallbackValue=False}" Value="True" />
                                                                    <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=EnableBackgroundImage, FallbackValue=False}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <ContentControl x:Name="BackgroundChanger_PluginBackgroundImage"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch" />
                                            </Grid>
                                            <!--Game background image Ends-->

                                            <!--Game video-->
                                            <Grid x:Name="GameVideo">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=VideoThumbnail, Path=IsChecked}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ElementName=ImageThumbnail, Path=IsChecked}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Rectangle>
                                                    <Rectangle.Fill>
                                                        <VisualBrush Visual="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound}" Stretch="UniformToFill" />
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                            </Grid>
                                            <!--Game video Ends-->

                                            <!--Daken Layer-->
                                            <Border Background="#99000000">
                                                <Border.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                                        <GradientStop Color="White" Offset="0" />
                                                        <GradientStop Color="Transparent" Offset="0.5" />
                                                    </LinearGradientBrush>
                                                </Border.OpacityMask>
                                            </Border>

                                        </Grid>

                                        <!--Extra Logo-->
                                        <Grid Margin="40,40,0,40" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Border x:Name="GameIcon" CornerRadius="{StaticResource ControlCornerRadius}" Tag="{DynamicResource DetailsViewAllowUseOfLogos}">
                                                <Image Name="PART_ImageIcon" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="Fant"
                                                        MaxHeight="120" MaxWidth="120" />
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}"
                                                                    Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="false">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Border x:Name="ExtraMetadataLoader_LogoLoaderControlGrid" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Tag="{DynamicResource DetailsViewAllowUseOfLogos}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}"
                                                                    Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="false">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl"
                                                                MaxHeight="{DynamicResource GameLogoMaxHeight}"
                                                                MaxWidth="{DynamicResource GameLogoMaxWidth}" />
                                            </Border>
                                        </Grid>
                                        <!--Extra Logo Ends-->

                                        <Grid VerticalAlignment="Bottom" Margin="40">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" MinHeight="80" /></Grid.RowDefinitions>

                                            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableVideoPlayer, FallbackValue=False}" Value="True" />
                                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsAnyVideoAvailable, FallbackValue=False}" Value="True" />
                                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableAlternativeDetailsVideoPlayer, FallbackValue=False}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <!--Image Thumbnail-->
                                                <Grid Width="120" Height="68">
                                                    <Grid Margin="4">
                                                        <Grid.OpacityMask>
                                                            <VisualBrush>
                                                                <VisualBrush.Visual>
                                                                    <Border Background="Black" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Grid.OpacityMask>
                                                        <Rectangle>
                                                            <Rectangle.Fill>
                                                                <VisualBrush Visual="{Binding ElementName=PART_ImageBackground}" Stretch="UniformToFill" />
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                    </Grid>
                                                    <Border Background="Transparent" BorderBrush="White" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Visibility="{Binding ElementName=ImageThumbnail, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <RadioButton Name="ImageThumbnail" GroupName="DetailsHeroMedia"
                                                            Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.VideoPauseCommand}"
                                                            Style="{DynamicResource TransparentRadioButton}"/>
                                                </Grid>
                                                <!--Video Thumbnail-->
                                                <Grid Margin="16,0,0,0" Width="120" Height="68">
                                                    <Grid Margin="4">
                                                        <Grid.OpacityMask>
                                                            <VisualBrush>
                                                                <VisualBrush.Visual>
                                                                    <Border Background="Black" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Grid.OpacityMask>
                                                        <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound">
                                                            <ContentControl.Template>
                                                                <ControlTemplate TargetType="ContentControl">
                                                                    <Viewbox Stretch="UniformToFill" VerticalAlignment="Top">
                                                                        <Grid>
                                                                            <ContentPresenter />
                                                                            <Border Background="Transparent" />
                                                                        </Grid>
                                                                    </Viewbox>
                                                                </ControlTemplate>
                                                            </ContentControl.Template>
                                                        </ContentControl>
                                                    </Grid>

                                                    <Border Background="#99000000" BorderBrush="#33FFFFFF" BorderThickness="1" Width="44" Height="44" CornerRadius="22"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Viewbox Name="ThumbnailPlay" Margin="13,12,11,12">
                                                            <TextBlock Text="&#xf5b0;" Foreground="White" Style="{StaticResource IconFontStyle}"/>
                                                        </Viewbox>
                                                    </Border>
                                                    <Border Background="Transparent" BorderBrush="White" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Visibility="{Binding ElementName=VideoThumbnail, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <RadioButton Name="VideoThumbnail" GroupName="DetailsHeroMedia"
                                                                 IsChecked="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.SettingsModel.Settings.IsVideoPlaying, Mode=OneWay, FallbackValue={StaticResource False}}"
                                                                 Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.VideoPlayCommand}" Style="{DynamicResource TransparentRadioButton}"/>
                                                </Grid>

                                            </StackPanel>

                                            <!--GameInfo-->
                                            <WrapPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,12,16,0">
                                                <Button Name="PART_ButtonReleaseDate" Margin="0,0,4,0" Padding="0" BorderThickness="0" Background="{x:Null}"
                                                        VerticalAlignment="Center"
                                                        Style="{DynamicResource PropertyItemSmallButton}" />

                                                <StackPanel Name="PART_ElemPlatform" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Settings DetailsVisibility.Platforms}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.Platforms}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="·" Margin="4,0" Foreground="#99FFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <ItemsControl ItemsSource="{Binding Game.Platforms}" Margin="0" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding Name}" Margin="4,0" Padding="0" BorderThickness="0" Background="{x:Null}"
                                                                        VerticalAlignment="Center"
                                                                        Style="{DynamicResource PropertyItemSmallButton}"
                                                                        Command="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=DataContext.SetPlatformFilterCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <Button Name="PART_ButtonSource" Margin="4,0" Padding="0" VerticalAlignment="Center"
                                                        Style="{DynamicResource PropertyItemOutlinedButton}" />

                                                <ContentControl x:Name="DuplicateHider_SourceSelector"
                                                                Height="24" Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                RenderOptions.BitmapScalingMode="Fant" />

                                                <ContentControl x:Name="NewsViewer_PlayersInGameViewerControl"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center" />

                                                <StackPanel Name="PART_ElemGenres" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Settings DetailsVisibility.Genres}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.Genres}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ItemsControl ItemsSource="{Binding Game.Genres}" Margin="0" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding Name}" Margin="4,0" Padding="0" VerticalAlignment="Center"
                                                                        Style="{DynamicResource PropertyItemOutlinedButton}"
                                                                        Command="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=DataContext.SetPlatformFilterCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                            </WrapPanel>

                                            <!-- Primary command followed by compact edit and favorite actions. -->
                                                <Grid x:Name="DuneGameActions" Grid.ColumnSpan="2" HorizontalAlignment="Left"
                                                      MinWidth="252" Width="{DynamicResource GameActionButtonWidth}"
                                                      MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0">
                                                        <Button Name="PART_ButtonPlayAction" Style="{DynamicResource DetailPlayButton}" />
                                                        <Button Name="PART_ButtonContextAction" Style="{DynamicResource DetailPlayButton}" />
                                                        <Button Name="PART_ButtonMoreActions" HorizontalAlignment="Right" Content="&#xe228;"
                                                                Style="{DynamicResource DetailPlayButtonRightPart}" />
                                                    </Grid>
                                                    <Button x:Name="PART_ButtonEditGame" Grid.Column="1" Margin="8,0,0,0"
                                                            Content="&#xe70f;" ToolTip="{DynamicResource LOCEditGame}"
                                                            Style="{StaticResource DuneIconActionButton}" />
                                                    <ToggleButton x:Name="ThemeExtras_FavoriteToggle" Grid.Column="2" Margin="8,0,0,0"
                                                                  Style="{DynamicResource DuneFavoriteIconToggle}"
                                                                  Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin, Status=Installed}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeExtras, Path=Game.Favorite, Mode=TwoWay, FallbackValue={StaticResource False}}" />
                                                </Grid>

                                        </Grid>

                                        <StackPanel Name="VideoControlButton" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,120">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsAnyVideoAvailable, FallbackValue=False}" Value="True" />
                                                                <Condition Binding="{Binding ElementName=VideoThumbnail, Path=IsChecked}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <ToggleButton HorizontalAlignment="Left" x:Name="TrailerPauseButton" Tag="&#xe103;"
                                                    Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.VideoPauseCommand, FallbackValue={x:Null}}"
                                                    Visibility="{Binding ElementName=TrailerPlayButton, Path=IsEnabled, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" Style="{DynamicResource IconRoundedToggleButton}">

                                            </ToggleButton>
                                            <ToggleButton HorizontalAlignment="Left" x:Name="TrailerPlayButton" Tag="&#xe102;"
                                                    Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.VideoPlayCommand, FallbackValue={x:Null}}"
                                                    Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{DynamicResource IconRoundedToggleButton}">

                                            </ToggleButton>

                                            <CheckBox Margin="8,0,0,0"
                                                    IsChecked="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound, Path=Content.IsPlayerMuted, Mode=TwoWay, FallbackValue={StaticResource True}}">
                                                <CheckBox.Template>
                                                    <ControlTemplate TargetType="CheckBox">
                                                        <Border Name="Border" BorderThickness="1" BorderBrush="#33FFFFFF" Background="#33000000" Width="36" Height="36" CornerRadius="18">
                                                            <TextBlock x:Name="NotMuted" Text="&#xe198;" Style="{StaticResource IconFontStyle}" Margin="8" Foreground="White" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Text" TargetName="NotMuted" Value="&#xe994;" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#66000000" TargetName="Border"/>
                                                                <Setter Property="BorderBrush" Value="#66FFFFFF" TargetName="Border" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </CheckBox.Template>
                                            </CheckBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.ColumnSpan="2" Grid.Row="1" Name="PART_ElemLinks" Margin="0,0,0,40">
                                        <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}" Style="{DynamicResource DetailViewCardBorder}"
                                                Margin="0,0,0,0" />
                                        <Grid Margin="16,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding Game.Links}" Margin="0,8,16,0"
                                                          Visibility="{Binding ElementName=PART_ElemLinks, Path=Visibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type Link}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="{Binding Name}" Style="{StaticResource PropertyItemLinkButton}" ToolTip="{Binding Url}"
                                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.OpenLinkCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="16,0,0,0"
                                                    BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1,0,0,0"
                                                    VerticalAlignment="Stretch"
                                                    Visibility="{PluginSettings Plugin=LibraryManagement, Path=EnableIntegrationFeatures, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ContentControl x:Name="LibraryManagement_PluginFeaturesIconList"
                                                                Height="{DynamicResource FeatureIconsHeight}" VerticalAlignment="Center"
                                                                HorizontalContentAlignment="Right" />
                                            </Border>
                                        </Grid>

                                    </Grid>

                                    <!-- Summary cards are generated from tools/SummaryCards.xml. -->
                                    <Grid x:Name="DuneSummary" Grid.Row="2">
                                        <Grid.Resources>
                                            <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0" />
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                <Setter Property="FontSize" Value="16" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </Grid.Resources>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                <Setter Property="Margin" Value="0,0,-12,0" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Visibility, ElementName=DuneHowLongToBeatCard}" Value="Collapsed" />
                                                            <Condition Binding="{Binding Visibility, ElementName=DuneActivityCard}" Value="Collapsed" />
                                                            <Condition Binding="{Binding Visibility, ElementName=DuneRequirementsCard}" Value="Collapsed" />
                                                            <Condition Binding="{Binding Visibility, ElementName=DuneAchievementsCard}" Value="Collapsed" />
                                                            <Condition Binding="{Binding Visibility, ElementName=DuneLanguagesSummary}" Value="Collapsed" />
                                                            <Condition Binding="{Binding Visibility, ElementName=DuneDlcSummary}" Value="Collapsed" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                                        <Setter Property="Margin" Value="0,0,8,0" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Visibility, ElementName=DuneHowLongToBeatCard}" Value="Visible" />
                                                            <Condition Binding="{Binding Visibility, ElementName=DuneActivityCard}" Value="Collapsed" />
                                                            <Condition Binding="{Binding Visibility, ElementName=DuneRequirementsCard}" Value="Collapsed" />
                                                            <Condition Binding="{Binding Visibility, ElementName=DuneAchievementsCard}" Value="Collapsed" />
                                                            <Condition Binding="{Binding Visibility, ElementName=DuneLanguagesSummary}" Value="Collapsed" />
