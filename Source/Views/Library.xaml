<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid d:DesignWidth="1500" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <!-- Keep Playnite's background part in Library so native image,
                             blur and transition bindings remain intact. The zero-sized
                             canvas lets it draw behind the adjacent sidebar without
                             changing the library's measured size. -->
                        <Canvas x:Name="DuneWindowBackgroundAnchor" Grid.RowSpan="2" Width="0" Height="0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                            <FadeImage x:Name="PART_ImageBackground" HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Canvas.Right="0" Canvas.Top="0">
                                <FadeImage.Width>
                                    <PriorityBinding>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=MainWindow}" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </PriorityBinding>
                                </FadeImage.Width>
                                <FadeImage.Height>
                                    <PriorityBinding>
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=MainWindow}" />
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </PriorityBinding>
                                </FadeImage.Height>

                                <FadeImage.ImageOpacityMask>
                                    <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="1" RadiusY="0.7">
                                        <RadialGradientBrush.GradientStops>
                                            <GradientStop Color="#99000000" Offset="0.4" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </RadialGradientBrush.GradientStops>
                                    </RadialGradientBrush>
                                </FadeImage.ImageOpacityMask>
                            </FadeImage>
                        </Canvas>

                        <DockPanel Grid.Row="1">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}"/>

                            <ExplorerPanel DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}"
                                           Visibility="{Settings ExplorerPanelVisible}"/>
                            
                            <Grid DockPanel.Dock="Left">                                
                                <LibraryDetailsView x:Name="PART_ViewDetails"/>
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>

                        <TopPanel VerticalAlignment="Top" Grid.Row="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter TargetName="DuneWindowBackgroundAnchor" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_ImageBackground" Property="Canvas.Right" Value="NaN" />
                            <Setter TargetName="PART_ImageBackground" Property="Canvas.Left" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter TargetName="DuneWindowBackgroundAnchor" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="DuneWindowBackgroundAnchor" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="PART_ImageBackground" Property="Canvas.Right" Value="NaN" />
                            <Setter TargetName="PART_ImageBackground" Property="Canvas.Left" Value="0" />
                            <Setter TargetName="PART_ImageBackground" Property="Canvas.Top" Value="NaN" />
                            <Setter TargetName="PART_ImageBackground" Property="Canvas.Bottom" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter TargetName="DuneWindowBackgroundAnchor" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_ImageBackground" Property="Canvas.Right" Value="NaN" />
                            <Setter TargetName="PART_ImageBackground" Property="Canvas.Left" Value="0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
