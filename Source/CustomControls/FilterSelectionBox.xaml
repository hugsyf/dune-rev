<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ControlTemplate x:Key="FilterSelectionBoxTemplate" TargetType="{x:Type FilterSelectionBoxBase}">
        <Grid>
            <Border x:Name="HoverBg" CornerRadius="{DynamicResource DuneInputCornerRadius}" BorderThickness="1" Background="{DynamicResource DuneInputFillBrush}" BorderBrush="{DynamicResource DuneInputBorderBrush}" />
            <Border Name="DuneBottomStroke" Height="1" Margin="4,0,4,0" VerticalAlignment="Bottom" Background="{DynamicResource DuneInputBottomBrush}" />
            <DockPanel>
                <!--Arrow-->
                <Path DockPanel.Dock="Right" Width="8" Height="5" Margin="0,0,12,0" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <TextBlock x:Name="PART_TextFilterString" Style="{StaticResource BaseTextBlockStyle}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="8,0,40,0" />
            </DockPanel>
            <ToggleButton x:Name="MainToggle" BorderThickness="0" Focusable="False" HorizontalContentAlignment="Stretch" Background="Transparent">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <TextBox x:Name="PART_TextFilterInput" BorderThickness="0" VerticalAlignment="Center" Margin="8,0,56,0" Background="Transparent" Style="{DynamicResource SearchSmallTextBox}" />
            <Button x:Name="PART_ButtonClearFilter" Margin="0,1,24,0" FontSize="12" HorizontalAlignment="Right" BorderThickness="0" Padding="4,0,4,0" Foreground="{DynamicResource PromptBrush}" ContentTemplate="{DynamicResource DuneClearInputIconTemplate}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DuneSubtleIconButton}">
                        <Setter Property="Visibility" Value="Visible" />
                    </Style>
                </Button.Style>
            </Button>
            <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True" Name="Popup" IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False" MaxHeight="300" MinWidth="{Binding ActualWidth, ElementName=MainToggle}" VerticalOffset="4">
                <Border Style="{DynamicResource DuneDropdownPopupBorder}" CornerRadius="{DynamicResource DuneFlyoutCornerRadius}" BorderBrush="{DynamicResource DuneInputBorderBrush}" BorderThickness="1" Padding="0,4">
                    <ItemsControl x:Name="PART_ItemsPanel" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverBg" Property="Background" Value="{DynamicResource DuneInputHoverBrush}" />
            </Trigger>
<Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DuneBottomStroke" Property="Height" Value="2" /><Setter TargetName="DuneBottomStroke" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter TargetName="DuneBottomStroke" Property="Opacity" Value="1" /></Trigger>
<Trigger SourceName="MainToggle" Property="IsChecked" Value="True"><Setter TargetName="DuneBottomStroke" Property="Height" Value="2" /><Setter TargetName="DuneBottomStroke" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter TargetName="DuneBottomStroke" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="FilterSelectionBoxItemStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="MinHeight" Value="36" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DuneInputHoverBrush}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type FilterEnumSelectionBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template" Value="{DynamicResource FilterSelectionBoxTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type FilterStringSelectionBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template" Value="{DynamicResource FilterSelectionBoxTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type FilterSelectionBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template" Value="{DynamicResource FilterSelectionBoxTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
