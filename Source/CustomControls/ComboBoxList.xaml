<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ControlTemplate x:Key="ComboBoxListBaseTemplate" TargetType="{x:Type ComboBoxListBase}">
        <Grid x:Name="Root">
            <Border x:Name="HoverBg" CornerRadius="{DynamicResource ControlCornerRadiusSmall}" Background="{DynamicResource ControlIdleBackgroundBrush}" BorderBrush="{DynamicResource ControlIdleBorderBrush}" BorderThickness="1" />
            <Border Name="DuneBottomStroke" Height="1" Margin="4,0,4,0" VerticalAlignment="Bottom" Background="{DynamicResource TextBrushDarker}" Opacity="0.5" />
            <DockPanel>
                <Path DockPanel.Dock="Right" Width="8" Height="5" Margin="0,0,12,0" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <TextBlock x:Name="PART_TextFilterString" Style="{StaticResource BaseTextBlockStyle}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="5,0,0,0" />
            </DockPanel>
            <ToggleButton x:Name="MainToggle" BorderThickness="0" Focusable="False" HorizontalContentAlignment="Stretch" Background="Transparent">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <Button x:Name="PART_ButtonClearFilter" Margin="0,0,20,0" FontSize="18" Background="Transparent" HorizontalAlignment="Right" BorderThickness="0" Padding="3,0,3,0" ContentTemplate="{DynamicResource ClearTextIconTemplate}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Visible" />
                    </Style>
                </Button.Style>
            </Button>
            <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True" Name="Popup" IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False" MaxHeight="300" MinWidth="{Binding ActualWidth, ElementName=MainToggle}" VerticalOffset="4">
                <Border Style="{DynamicResource PopupBorder}" CornerRadius="{DynamicResource ControlCornerRadius}">
                    <ItemsControl x:Name="PART_ItemsPanel" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverBg" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
            </Trigger>
<Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DuneBottomStroke" Property="Height" Value="2" /><Setter TargetName="DuneBottomStroke" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter TargetName="DuneBottomStroke" Property="Opacity" Value="1" /></Trigger>
<Trigger SourceName="MainToggle" Property="IsChecked" Value="True"><Setter TargetName="DuneBottomStroke" Property="Height" Value="2" /><Setter TargetName="DuneBottomStroke" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter TargetName="DuneBottomStroke" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate>
    <!--Selector in Edit panle-->
    <ControlTemplate x:Key="FilterComboBoxListTemplate" TargetType="{x:Type ComboBoxListBase}">
        <Grid x:Name="Root">
            <Border x:Name="HoverBg" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadiusSmall}" Background="{DynamicResource ControlIdleBackgroundBrush}" BorderBrush="{DynamicResource ControlIdleBorderBrush}" />
            <Border Name="DuneBottomStroke" Height="1" Margin="4,0,4,0" VerticalAlignment="Bottom" Background="{DynamicResource TextBrushDarker}" Opacity="0.5" />
            <DockPanel>
                <Path DockPanel.Dock="Right" Width="8" Height="5" Margin="0,0,12,0" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <TextBlock x:Name="PART_TextFilterString" Style="{StaticResource BaseTextBlockStyle}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="8,0,24,0" />
            </DockPanel>
            <ToggleButton x:Name="MainToggle" BorderThickness="0" Focusable="False" HorizontalContentAlignment="Stretch" Background="Transparent">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <Button x:Name="PART_ButtonClearFilter" Margin="0,1,26,0" FontSize="12" Background="Transparent" HorizontalAlignment="Right" Opacity="0.4" VerticalAlignment="Center" BorderThickness="0" Padding="0" ContentTemplate="{DynamicResource ClearTextIconTemplate}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Visibility" Value="Visible" />
                    </Style>
                </Button.Style>
            </Button>
            <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True" Name="Popup" IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False" MaxHeight="300" MinWidth="{Binding ActualWidth, ElementName=MainToggle}" VerticalOffset="4">
                <Border Style="{DynamicResource PopupBorder}" CornerRadius="{DynamicResource ControlCornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="8" Name="PART_ElemSearchHost">
                            <CheckBox DockPanel.Dock="Right" x:Name="PART_ToggleSelectedOnly" ToolTip="{DynamicResource LOCOnlyItemsSelectedTooltip}" FontFamily="{DynamicResource FontIcoFont}" />
                            <SearchBox DockPanel.Dock="Left" Margin="0,0,8,0" x:Name="PART_SearchBox" />
                        </DockPanel>
                        <ItemsControl x:Name="PART_ItemsPanel" Grid.Row="1" />
                    </Grid>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverBg" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
            </Trigger>
<Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DuneBottomStroke" Property="Height" Value="2" /><Setter TargetName="DuneBottomStroke" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter TargetName="DuneBottomStroke" Property="Opacity" Value="1" /></Trigger>
<Trigger SourceName="MainToggle" Property="IsChecked" Value="True"><Setter TargetName="DuneBottomStroke" Property="Height" Value="2" /><Setter TargetName="DuneBottomStroke" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter TargetName="DuneBottomStroke" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="ComboBoxListItemStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Padding" Value="8,0,8,8" />
    </Style>
    <Style TargetType="{x:Type ComboBoxList}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template" Value="{DynamicResource ComboBoxListBaseTemplate}" />
    </Style>
    <Style TargetType="{x:Type DdItemListSelectionBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template" Value="{DynamicResource FilterComboBoxListTemplate}" />
    </Style>
</ResourceDictionary>