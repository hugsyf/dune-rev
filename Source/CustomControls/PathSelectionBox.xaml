<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type PathSelectionBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <DockPanel>
                        <Button x:Name="PART_ButtonDirectorySelect" DockPanel.Dock="Right" Style="{DynamicResource DuneSubtleIconButton}" Margin="4,0,0,0"
                                Content="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{DynamicResource LOCSelectDirectoryTooltip}" />
                        <Button x:Name="PART_ButtonFileSelect" DockPanel.Dock="Right" Style="{DynamicResource DuneSubtleIconButton}" Margin="4,0,0,0"
                                Content="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{DynamicResource LOCSelectFileTitle}" />
                    <Grid>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource DuneInputCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="True" Focusable="False"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" />
                        </Border>
                        <Border x:Name="BottomStroke" Height="1" Margin="4,0" VerticalAlignment="Bottom" Background="{DynamicResource DuneInputBottomBrush}" IsHitTestVisible="False" />
                    </Grid>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DuneInputHoverBrush}" /></Trigger>
                        <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="Surface" Property="Background" Value="Transparent" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="BottomStroke" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="BottomStroke" Property="Height" Value="2" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DuneValidationBrush}" />
                            <Setter TargetName="BottomStroke" Property="Background" Value="{DynamicResource DuneValidationBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>