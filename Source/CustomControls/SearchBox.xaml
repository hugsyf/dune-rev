<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid Height="32">
                        <Border x:Name="HoverBg" BorderThickness="1" CornerRadius="{DynamicResource DuneInputCornerRadius}" Background="{DynamicResource DuneInputFillBrush}" BorderBrush="{DynamicResource DuneInputBorderBrush}" />
                        <Border x:Name="DuneBottomStroke" Height="1" Margin="4,0,4,0" VerticalAlignment="Bottom" Background="{DynamicResource DuneInputBottomBrush}" />
                        <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource SearchSmallTextBox}"
                                 VerticalContentAlignment="Center" Margin="8,0,32,0" Background="Transparent" Padding="0"/>
                        <ContentControl x:Name="PART_SeachIcon" ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="14"
                                        Foreground="{DynamicResource TextBrushDarker}" IsHitTestVisible="False" />
                        <ContentControl x:Name="PART_ClearTextIcon" ContentTemplate="{DynamicResource DuneClearInputIconTemplate}"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" Width="24" Height="24" FontSize="12"
                                        Foreground="{DynamicResource TextBrushDarker}" Cursor="Hand" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DuneInputHoverBrush}" TargetName="HoverBg"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="HoverBg" Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
                            <Setter TargetName="DuneBottomStroke" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="DuneBottomStroke" Property="Height" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid x:Name="BoxGrid" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" ClipToBounds="False">

                        <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource SearchTextBox}" Width="120" HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center" Padding="12,0,32,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                            <ContentControl x:Name="PART_SeachIcon" ContentTemplate="{DynamicResource SearchTextIconTemplate}" FontSize="{DynamicResource FontSizeLarge}"
                                    Margin="14,1,4,0" Opacity="0.6" />

                            <TextBlock x:Name="Prompt" Text="{DynamicResource LOCSearchLabel}"
                                       Margin="0,0,0,0" FontSize="{DynamicResource FontSize}" Opacity="0.6"/>

                        </StackPanel>
                        <ContentControl x:Name="PART_ClearTextIcon"
                                        ContentTemplate="{DynamicResource DuneClearInputIconTemplate}" Cursor="Hand" Opacity="0.8"
                                        FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ElementName=PART_SeachIcon, Path=Visibility}" Value="Collapsed">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Prompt"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_TextInpuText"
                                                         Storyboard.TargetProperty="Width"
                                                         To="300" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_TextInpuText"
                                                         Storyboard.TargetProperty="Width"
                                                         To="100" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>
