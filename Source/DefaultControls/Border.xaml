    <Style TargetType="Border">
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />

    </Style>

    <Style x:Key="DetailViewCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlOverlayBrush}" />
        <Setter Property="Opacity" Value="0.06" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                <Setter Property="Opacity" Value="0.1" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DuneSummaryPluginCardBorder" TargetType="Border" BasedOn="{StaticResource DetailViewCardBorder}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                <Setter Property="Opacity" Value="0.1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Keep interactive cards inside their measured bounds. Scaling a card with
         an effect also scales/rasterizes its selected outline and can crop the
         left edge. The card surface and toggle supply hover/selection feedback. -->
    <Style x:Key="ClickableDetailCard" TargetType="Grid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Panel.ZIndex" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>


