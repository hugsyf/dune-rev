    <Style TargetType="Border">
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Uid" Value="Dune.Material.Popup" />
        <Setter Property="Tag" Value="{DynamicResource DuneMaterialsEnabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="Background">
            <Setter.Value>
                <PriorityBinding>
                    <Binding RelativeSource="{RelativeSource Self}" Converter="{PluginConverter Plugin=DuneMaterials, Converter=MaterialBrushConverter}" ConverterParameter="Resource:PopupBackgroundBrush" />
                    <Binding Path="Resources[PopupBackgroundBrush]" Source="{x:Static Application.Current}" />
                </PriorityBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DuneFlyoutCornerRadius}" />

    </Style>

    <Style x:Key="DuneDropdownPopupBorder" TargetType="Border" BasedOn="{StaticResource PopupBorder}">
        <Setter Property="Background">
            <Setter.Value>
                <PriorityBinding>
                    <Binding RelativeSource="{RelativeSource Self}" Converter="{PluginConverter Plugin=DuneMaterials, Converter=MaterialBrushConverter}" ConverterParameter="Resource:DuneDropdownSurfaceBrush" />
                    <Binding Path="Resources[DuneDropdownSurfaceBrush]" Source="{x:Static Application.Current}" />
                </PriorityBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource DuneInputBorderBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DuneFlyoutCornerRadius}" />
    </Style>

    <Style x:Key="DetailViewCardBorder" TargetType="Border">
        <Setter Property="Uid" Value="Dune.Material.Card" />
        <Setter Property="Tag" Value="{DynamicResource DuneMaterialsEnabled}" />
        <Setter Property="Background">
            <Setter.Value>
                <PriorityBinding>
                    <Binding RelativeSource="{RelativeSource Self}" Converter="{PluginConverter Plugin=DuneMaterials, Converter=MaterialBrushConverter}" ConverterParameter="Resource:DuneCardSurfaceBrush" />
                    <Binding Path="Resources[DuneCardSurfaceBrush]" Source="{x:Static Application.Current}" />
                </PriorityBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource DuneSurfaceEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Dense expanded content uses a shared stronger blur, keeping small cards airy. -->
    <Style x:Key="DuneContentCardBorder" TargetType="Border" BasedOn="{StaticResource DetailViewCardBorder}">
        <Setter Property="Uid" Value="Dune.Material.Content" />
    </Style>

    <!-- Summary cards use individual surfaces unless the combined surface is visible. -->
    <Style x:Key="DuneSummaryCardBorder" TargetType="Border" BasedOn="{StaticResource DetailViewCardBorder}">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadiusLarge}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Visibility, ElementName=DuneBasicSurface}" Value="Visible">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DuneSummaryPluginCardBorder" TargetType="Border" BasedOn="{StaticResource DuneSummaryCardBorder}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <PriorityBinding>
                            <Binding RelativeSource="{RelativeSource Self}" Converter="{PluginConverter Plugin=DuneMaterials, Converter=MaterialBrushConverter}" ConverterParameter="Resource:DuneCardHoverBrush" />
                            <Binding Path="Resources[DuneCardHoverBrush]" Source="{x:Static Application.Current}" />
                        </PriorityBinding>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Keep interactive cards inside their measured bounds. Scaling a card with
         an effect also scales/rasterizes its focus indicator and can crop the
         left edge. The card surface and toggle supply hover/selection feedback. -->
    <Style x:Key="ClickableDetailCard" TargetType="Grid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Panel.ZIndex" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>


