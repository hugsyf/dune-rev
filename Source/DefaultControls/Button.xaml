<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource DuneInputFillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DuneInputBorderBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="12,4,12,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border Uid="{TemplateBinding Uid}" Tag="{TemplateBinding Tag}" BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource DuneInputCornerRadius}">
                            <Border.Background>
                                <PriorityBinding>
                                    <Binding RelativeSource="{RelativeSource Self}" Converter="{PluginConverter Plugin=DuneMaterials, Converter=MaterialBrushConverter}" ConverterParameter="TemplateBackground" />
                                    <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}" />
                                </PriorityBinding>
                            </Border.Background>
                        </Border>
                        <Border x:Name="HoverBg" Background="{DynamicResource ControlOverlayBrush}" Opacity="0"
                                CornerRadius="{DynamicResource DuneInputCornerRadius}" />
                        <Border x:Name="PressedBg" Background="{DynamicResource ControlShadeBrush}" Opacity="0"
                                CornerRadius="{DynamicResource DuneInputCornerRadius}" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.12" TargetName="PressedBg" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0.04" Duration="0:0:0.083">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.083">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="DunePluginActionButtonTemplate" TargetType="Button">
        <Border x:Name="Surface" Background="Transparent" CornerRadius="{DynamicResource DuneInputCornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DuneInputHoverBrush}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DuneInputHoverBrush}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DuneInputPressedBrush}" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="DunePluginIconButtonTemplate" TargetType="Button">
        <Border x:Name="Surface" Background="Transparent" CornerRadius="{DynamicResource DuneInputCornerRadius}" Padding="8">
            <!-- Native plugins often set FontSize locally (24 or 40). Scale the
                 visual, preserving their glyph font, content and click handlers. -->
            <Viewbox Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter ContentSource="Content" RecognizesAccessKey="True" />
            </Viewbox>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DuneInputHoverBrush}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DuneInputHoverBrush}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DuneInputPressedBrush}" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="DunePluginActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource DunePluginActionButtonTemplate}" />
        <Style.Triggers>
            <!-- Scoped to addon hosts: their single-character labels are glyphs
                 or + actions. Text actions retain their natural width. -->
            <DataTrigger Binding="{Binding Content.Length, RelativeSource={RelativeSource Self}, FallbackValue=0}" Value="1">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Template" Value="{StaticResource DunePluginIconButtonTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DunePluginIconButton" TargetType="Button" BasedOn="{StaticResource DunePluginActionButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Template" Value="{StaticResource DunePluginIconButtonTemplate}" />
    </Style>

    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
    <Style x:Key="DuneSubtleIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource DuneInputCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Content" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DuneInputHoverBrush}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource DuneInputHoverBrush}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource DuneInputPressedBrush}" /></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
