<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="HighlightBorder" TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="CornerRadius" Value="{DynamicResource DuneInputCornerRadius}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Background" Value="{DynamicResource DuneInputFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DuneInputBorderBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DuneInputHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DuneInputBottomBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HighlightBg" TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="CornerRadius" Value="{DynamicResource DuneInputCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource DuneInputFillBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DuneSelectionFillBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource DuneSelectionFillBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HoverBg" TargetType="Border" >
        <Setter Property="CornerRadius" Value="{DynamicResource DuneInputCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="SelectedBg" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource DuneInputCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</ResourceDictionary>