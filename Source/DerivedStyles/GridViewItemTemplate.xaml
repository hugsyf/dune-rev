<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:p="clr-namespace:Playnite;assembly=Playnite"
                    xmlns:popt="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="d">

    <!-- The visible cover background may be transparent. Keep it separate from
         the opaque visuals used for clipping covers and selection feedback. -->
    <Style TargetType="Border" x:Key="VisualBrushBorderMask">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadiusLarge}" />
        <Setter Property="Visibility" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                <Setter Property="CornerRadius" Value="0,0,0,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- DuplicateHider looks up this conventional resource key for source icons. -->
    <Style x:Key="DuplicateHider_IconContentControlStyle1"
           BasedOn="{StaticResource {x:Type ContentControl}}"
           TargetType="ContentControl">
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{x:Null}" />
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="IconBackground"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource DuneInputHoverBrush}"
                                Opacity="0"
                                Visibility="Hidden" />
                        <Image Source="{Binding Icon}"
                               RenderOptions.BitmapScalingMode="Fant"
                               Margin="3"
                               Opacity="0.95" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconBackground" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IconBackground" Property="Opacity" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keep the native state control IsVisible so its game/group subscriptions remain active. -->
    <Style x:Key="DuneCoverCopyStateStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="ContentControl"><Border /></ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="{DynamicResource CardSurfaceBrush}" ToolTip="{Binding Game.Name}">

                        <StackPanel Name="PART_PanelHost"
                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">

                            <Grid Width="{Settings GridItemWidth}"  Height="{Settings GridItemHeight}">
                                <Border x:Name="DuneReduceCoverMotionPreference" Tag="{DynamicResource DuneReduceCoverMotion}" Visibility="Collapsed" />

                                <Border Style="{StaticResource VisualBrushBorderMask}" Name="Mask" Tag="{DynamicResource GridViewGameCoverUseRoundedCorners}">

                                </Border>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=Mask, Path=Tag}" Value="True">
                                                    <Setter Property="OpacityMask">
                                                        <Setter.Value>
                                                            <!-- Theme brushes are parsed before MainModel exists.
                                                                 Read settings directly from the application. -->
                                                            <VisualBrush>
                                                                <VisualBrush.Visual>
                                                                    <Border Background="White" CornerRadius="{DynamicResource ControlCornerRadiusLarge}"
                                                                            Width="{Binding Source={x:Static p:PlayniteApplication.Current}, Path=AppSettings.GridItemWidth}"
                                                                            Height="{Binding Source={x:Static p:PlayniteApplication.Current}, Path=AppSettings.GridItemHeight}" />
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <!-- Keep the strip inside the cover's shared rounded mask. Platform
                                         lookups are independent of ThemeExtras' source-first cache, so
                                         disabling source labels cannot leave a store banner selected. -->
                                    <Grid x:Name="DuneCoverPlatformHeader" Height="{DynamicResource GridViewPlatformBannerHeight}"
                                          Tag="{DynamicResource GridViewGameCoverShowPlatformBanner}" IsHitTestVisible="False"
                                          Background="{DynamicResource CardSurfaceBrush}" ClipToBounds="True">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Source, ElementName=DuneCoverBannerImage}" Value="{x:Null}" />
                                                            <Condition Binding="{Binding Text, ElementName=DuneCoverBannerText}" Value="" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border x:Name="DuneSourceBannerPreference" Tag="{DynamicResource GridViewGameCoverPreferSourceBanner}" Visibility="Collapsed" />
                                        <Border x:Name="DuneManualBannerPreference" Tag="{DynamicResource DuneManualGamesPreferPlatformBanner}" Visibility="Collapsed" />
<Border x:Name="DuneUseSourceBanner" Visibility="Collapsed"><Border.Style><Style TargetType="Border">
<Setter Property="Tag" Value="{StaticResource False}" /><Style.Triggers>
<MultiDataTrigger><MultiDataTrigger.Conditions>
<Condition Binding="{Binding Tag, ElementName=DuneSourceBannerPreference}" Value="True" />
<Condition Binding="{Binding Game.Platforms[0].SpecificationId, FallbackValue=''}" Value="pc_windows" />
</MultiDataTrigger.Conditions><Setter Property="Tag" Value="{StaticResource True}" /></MultiDataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions>
<Condition Binding="{Binding Tag, ElementName=DuneSourceBannerPreference}" Value="True" />
<Condition Binding="{Binding Game.Platforms[0].SpecificationId, FallbackValue=''}" Value="macintosh" />
</MultiDataTrigger.Conditions><Setter Property="Tag" Value="{StaticResource True}" /></MultiDataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions>
<Condition Binding="{Binding Tag, ElementName=DuneSourceBannerPreference}" Value="True" />
<Condition Binding="{Binding Game.Platforms[0].SpecificationId, FallbackValue=''}" Value="linux" />
</MultiDataTrigger.Conditions><Setter Property="Tag" Value="{StaticResource True}" /></MultiDataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions>
<Condition Binding="{Binding Tag, ElementName=DuneSourceBannerPreference}" Value="True" />
<Condition Binding="{Binding Game.Platforms[0].SpecificationId, FallbackValue=''}" Value="pc_linux" />
</MultiDataTrigger.Conditions><Setter Property="Tag" Value="{StaticResource True}" /></MultiDataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions>
<Condition Binding="{Binding Tag, ElementName=DuneSourceBannerPreference}" Value="True" />
<Condition Binding="{Binding Game.Platforms.Count, FallbackValue=0}" Value="0" />
</MultiDataTrigger.Conditions><Setter Property="Tag" Value="{StaticResource True}" /></MultiDataTrigger>
<!-- Playnite/manual libraries describe how the entry was added, not its platform. -->
<MultiDataTrigger><MultiDataTrigger.Conditions>
    <Condition Binding="{Binding Tag, ElementName=DuneManualBannerPreference}" Value="True" />
    <Condition Binding="{Binding Text, ElementName=DuneCoverPluginId}" Value="00000000-0000-0000-0000-000000000000" />
</MultiDataTrigger.Conditions>
    <Setter Property="Tag" Value="{StaticResource False}" />
</MultiDataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions>
    <Condition Binding="{Binding Tag, ElementName=DuneManualBannerPreference}" Value="True" />
    <Condition Binding="{Binding Game.Source.Name, FallbackValue='', TargetNullValue=''}" Value="Playnite" />
</MultiDataTrigger.Conditions>
    <Setter Property="Tag" Value="{StaticResource False}" />
</MultiDataTrigger></Style.Triggers></Style></Border.Style></Border>
<Image x:Name="DuneSourceNamePng" Visibility="Collapsed" Source="{ThemeFileBinding Game.Source.Name, PathFormat='Images/Banners/SourceName/{0}.png', Converter={StaticResource ImageStringToImageConverterCached}}" />
<Image x:Name="DuneSourceNameJpg" Visibility="Collapsed" Source="{ThemeFileBinding Game.Source.Name, PathFormat='Images/Banners/SourceName/{0}.jpg', Converter={StaticResource ImageStringToImageConverterCached}}" />
<TextBlock x:Name="DuneCoverPluginId" Visibility="Collapsed" Text="{Binding Game.PluginId}" />
<Image x:Name="DunePluginBanner" Visibility="Collapsed" DataContext="{Binding ElementName=DuneCoverPluginId}" Source="{ThemeFileBinding Text, PathFormat='Images/Banners/PluginId/{0}.png', Converter={StaticResource ImageStringToImageConverterCached}}" />
<!-- Native lookups also retain platform art without ThemeExtras.
                                             Missing files return UnsetValue; the next candidate can win. -->
                                        <Image x:Name="DunePlatformSpecPng" Visibility="Collapsed"
                                               Source="{ThemeFileBinding Game.Platforms[0].SpecificationId, PathFormat='Images/Banners/PlatformSpecId/{0}.png', Converter={StaticResource ImageStringToImageConverterCached}}" />
                                        <Image x:Name="DunePlatformSpecJpg" Visibility="Collapsed"
                                               Source="{ThemeFileBinding Game.Platforms[0].SpecificationId, PathFormat='Images/Banners/PlatformSpecId/{0}.jpg', Converter={StaticResource ImageStringToImageConverterCached}}" />
                                        <Image x:Name="DunePlatformNamePng" Visibility="Collapsed"
                                               Source="{ThemeFileBinding Game.Platforms[0].Name, PathFormat='Images/Banners/PlatformName/{0}.png', Converter={StaticResource ImageStringToImageConverterCached}}" />
                                        <Image x:Name="DunePlatformNameJpg" Visibility="Collapsed"
                                               Source="{ThemeFileBinding Game.Platforms[0].Name, PathFormat='Images/Banners/PlatformName/{0}.jpg', Converter={StaticResource ImageStringToImageConverterCached}}" />
                                        <Image x:Name="DunePlatformBannerImage" Visibility="Collapsed">
                                            <Image.Source>
                                                <PriorityBinding>
                                                    <Binding ElementName="DunePlatformSpecPng" Path="Source" Converter="{StaticResource NullToDependencyPropertyUnsetConverter}" />
                                                    <Binding ElementName="DunePlatformSpecJpg" Path="Source" Converter="{StaticResource NullToDependencyPropertyUnsetConverter}" />
                                                    <Binding ElementName="DunePlatformNamePng" Path="Source" Converter="{StaticResource NullToDependencyPropertyUnsetConverter}" />
                                                    <Binding ElementName="DunePlatformNameJpg" Path="Source" Converter="{StaticResource NullToDependencyPropertyUnsetConverter}" />
                                                </PriorityBinding>
                                            </Image.Source>
                                        </Image>
                                        <!-- ThemeExtras selects source/plugin banners for PC games, while
                                             retaining platform artwork for consoles. It only supplies data. -->
                                        <ContentControl x:Name="ThemeExtras_Banner" Visibility="Collapsed" IsHitTestVisible="False" />
                                        <TextBlock x:Name="DuneCoverBannerText" Tag="{DynamicResource GridViewGameCoverPreferSourceBanner}"
                                                   Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                    <Setter Property="Text" Value="{Binding Game.Platforms[0].Name, FallbackValue='', TargetNullValue=''}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, ElementName=DuneUseSourceBanner}" Value="True">
                                                            <Setter Property="Text" Value="{Binding Game.Source.Name, FallbackValue='', TargetNullValue=''}" />
                                                        </DataTrigger>
                                                        
                                                        
                                                        <DataTrigger Binding="{Binding Game.Source.Name, FallbackValue='', TargetNullValue=''}" Value="">
                                                            <Setter Property="Text" Value="{Binding Game.Platforms[0].Name, FallbackValue='', TargetNullValue=''}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source, ElementName=DuneCoverBannerImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Fill removes letterboxing; the outer cover mask rounds the
                                             strip's top corners at exactly the cover's own dimensions. -->
                                        <Image x:Name="DuneCoverBannerImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant"
                                               Tag="{DynamicResource GridViewGameCoverPreferSourceBanner}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{Binding Source, ElementName=DunePlatformBannerImage}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, ElementName=DuneUseSourceBanner}" Value="True">
                                                            <Setter Property="Source">
                                                                <Setter.Value>
                                                                    <PriorityBinding>
<Binding ElementName="DuneSourceNamePng" Path="Source" Converter="{StaticResource NullToDependencyPropertyUnsetConverter}" />
<Binding ElementName="DuneSourceNameJpg" Path="Source" Converter="{StaticResource NullToDependencyPropertyUnsetConverter}" />
<Binding ElementName="DunePluginBanner" Path="Source" Converter="{StaticResource NullToDependencyPropertyUnsetConverter}" />
                                                                        <Binding ElementName="ThemeExtras_Banner" Path="Content.Content.Source" Converter="{StaticResource NullToDependencyPropertyUnsetConverter}" />
                                                                        <Binding ElementName="DunePlatformBannerImage" Path="Source" Converter="{StaticResource NullToDependencyPropertyUnsetConverter}" />
                                                                    </PriorityBinding>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                    <Grid Grid.Row="1" ClipToBounds="True">
                                        <Image Name="PART_ImageCover" SnapsToDevicePixels="True" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both" Stretch="{Settings CoverArtStretch}" />
                                        <Grid Tag="{DynamicResource GridViewGameCoverShowFavorite}"
                                                Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Viewbox VerticalAlignment="Top" HorizontalAlignment="Right" Grid.Column="4">
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Border Background="{DynamicResource ControlBackgroundBrush}" Width="32" Height="32" CornerRadius="16"
                                                            Margin="0,8,8,0" Opacity="0.6" />
                                                    <TextBlock Text="&#xe00a;" Foreground="White" Margin="6,14,14,6" Style="{DynamicResource IconFontStyle}" />
                                                </Grid>
                                            </Viewbox>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <!--Game Not Installed-->
                                <Border x:Name="TextGameName" CornerRadius="{Binding ElementName=Mask, Path=CornerRadius}" Visibility="Collapsed">
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Margin="8" Style="{StaticResource BaseTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <Border x:Name="BorderMouseOver" Background="{DynamicResource ControlOverlayBrush}"
                                        CornerRadius="{Binding ElementName=Mask, Path=CornerRadius}" Opacity="0" />

                                <Border x:Name="SelectedGameBorder" Background="{DynamicResource GridViewGameCoverSelectedBackgroundBrush}"
                                        CornerRadius="{Binding ElementName=Mask, Path=CornerRadius}" Opacity="0">
                                    <Grid Margin="4">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=Mask, Path=Tag}" Value="True">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <VisualBrush>
                                                                    <VisualBrush.Visual>
                                                                        <Border Background="White" CornerRadius="{DynamicResource ControlCornerRadiusLarge}"
                                                                                Width="{Binding Source={x:Static p:PlayniteApplication.Current}, Path=AppSettings.GridItemWidth}"
                                                                                Height="{Binding Source={x:Static p:PlayniteApplication.Current}, Path=AppSettings.GridItemHeight}" />
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Rectangle Stroke="#3DFFFFFF" StrokeDashArray="6,3" StrokeThickness="1" RadiusX="{Binding ElementName=Mask, Path=CornerRadius.TopLeft}"
                                                RadiusY="{Binding ElementName=Mask, Path=CornerRadius.TopLeft}" />
                                        <Canvas IsHitTestVisible="False">
                                            <Line X1="0" Y1="0" X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                    Y2="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" Stroke="#3DFFFFFF" StrokeThickness="1" />
                                        </Canvas>
                                    </Grid>
                                </Border>

                                <Border x:Name="GlowPlayingBorder" Visibility="Collapsed" Tag="False" CornerRadius="{Binding ElementName=Mask, Path=CornerRadius}"
                                        Style="{DynamicResource CoverIsPlayingAnimatedBackground}" />

                                <TextBlock Name="EnablePlayingGlowBorder" Visibility="Collapsed" Tag="{DynamicResource GridViewEnablePlayingGlowBorder}" />

                                <Border Name="ShineBackground" Tag="False" IsHitTestVisible="False" CornerRadius="{Binding ElementName=Mask, Path=CornerRadius}"
                                        Style="{DynamicResource AnimatedCoverShineBackground}" />

                                <TextBlock Name="EnableHighlightAnimation" Visibility="Collapsed" Tag="{DynamicResource GridViewGameCoverShowShineAnimation}" />

                                <Border Tag="{DynamicResource DuneGridShowUserScore}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="8" Padding="8,4" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{DynamicResource PopupBackgroundBrush}" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Game.UserScore}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE734;" Style="{StaticResource IconFontStyle}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Game.UserScore}" />
                                    </StackPanel>
                                </Border>
                                
                                <Grid Name="GameControls" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Grid.Column="3" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                        <Button Name="PART_ButtonPlay" Content="&#xf5b0;" Margin="6,6,2,2" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                Style="{DynamicResource GridViewPlayButton}" />
                                    </Viewbox>
                                    <Viewbox Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                        <Button Name="PART_ButtonInfo" Content="&#xedb1;" Margin="8,0,0,8" Width="32" Height="32" Style="{DynamicResource GridViewInfoButton}" />
                                    </Viewbox>
                                </Grid>
                            </Grid>

                            <ContentControl x:Name="DuplicateHider_ContentControl1" Tag="{StaticResource DuneCoverCopyStateStyle}"
                                            Width="0" Height="0" Opacity="0" IsHitTestVisible="False" Focusable="False" />
                            <Grid Width="{Settings GridItemWidth}" Height="28" Tag="{DynamicResource DuneGridShowCopySelector}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    <Condition Binding="{Binding Content.MoreThanOneCopy, ElementName=DuplicateHider_ContentControl1, FallbackValue=False}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ContentControl x:Name="DuplicateHider_SourceSelector1" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=GameListItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=EnableHighlightAnimation, Path=Tag}" Value="True" />
                                <Condition Binding="{Binding Tag, ElementName=DuneReduceCoverMotionPreference}" Value="False" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Tag" Value="True" TargetName="ShineBackground" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsVisible}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static p:PlayniteApplication.Current}, Path=IsActive}" Value="True" />
                                <Condition Binding="{Binding ElementName=EnablePlayingGlowBorder, Path=Tag}" Value="True" />
                                <Condition Binding="{Binding Tag, ElementName=DuneReduceCoverMotionPreference}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Tag" Value="True" TargetName="GlowPlayingBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="GlowPlayingBorder" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="&#xe118;" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="1" TargetName="SelectedGameBorder" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="GameControls" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="GameControls" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity" To="0.24" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CoverIsPlayingAnimatedBackground" TargetType="Border">
        <Style.Resources>
            <Color x:Key="BackgroundColor1">#26ffffff</Color>
            <Color x:Key="BackgroundColor2">#00000000</Color>
            <Color x:Key="BackgroundColor3">#99000000</Color>
        </Style.Resources>
        <Setter Property="Background" x:Name="AnimatedBackground">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource BackgroundColor2}" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
