<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--ThemeModifier Options-->
        <!--
        One Fluent Dim palette, shared by theme controls and extensions.
        ThemeDarkStyle remains a compatibility flag only; no theme template
        switches palettes or uses Tag to carry a color-mode setting.
        -->
        <sys:Boolean x:Key="ThemeDarkStyle">True</sys:Boolean>
        <sys:Boolean x:Key="DetailsViewAllowUseOfLogos">True</sys:Boolean>
        <sys:Boolean x:Key="GridViewAllowUseOfLogos">True</sys:Boolean>

        <sys:Double x:Key="GameOverviewWidth">1760</sys:Double>
        <sys:Double x:Key="GameDetailInfoWidth">480</sys:Double>
        <sys:Double x:Key="GridViewDetailsWidth">640</sys:Double>
        <sys:Double x:Key="TopPanelHeight">60</sys:Double>
        <sys:Double x:Key="GameLogoMaxWidth">480</sys:Double>
        <sys:Double x:Key="GameLogoMaxHeight">120</sys:Double>
        <sys:Double x:Key="GameActionButtonWidth">200</sys:Double>
        <sys:Double x:Key="DetailsSummaryCardWidth">240</sys:Double>
        <sys:Double x:Key="DetailsSummaryCardHeight">136</sys:Double>
        <sys:Double x:Key="GridSummaryCardWidth">260</sys:Double>
        <sys:Double x:Key="GridSummaryCardHeight">136</sys:Double>
        <sys:Double x:Key="FeatureIconsHeight">24</sys:Double>
        <sys:Double x:Key="SuccessStoryPanelMinHeight">300</sys:Double>
        <sys:Double x:Key="ScreenshotsPanelHeight">500</sys:Double>

        <sys:Boolean x:Key="ShowIconTextOnLink">True</sys:Boolean>
        <CornerRadius x:Key="GridViewCoverCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="GridViewCoverGridBackgroundDisabledCornerRadius">8,8,8,8</CornerRadius>
        <CornerRadius x:Key="GridViewSelectionBorderCornerRadius">16</CornerRadius>

        <!--ThemeModifier Grid View Settings-->
        <sys:Boolean x:Key="GridViewGameCoverUseRoundedCorners">True</sys:Boolean>
        <sys:Boolean x:Key="GridViewGameCoverShowFavorite">True</sys:Boolean>
        <sys:Boolean x:Key="GridViewGameCoverShowShineAnimation">True</sys:Boolean>
        <sys:Boolean x:Key="GridViewGameCoverShowHighlightBorder">True</sys:Boolean>
        <Visibility x:Key="GridViewGameCoverShowCompletionStatus">Visible</Visibility>
        <Visibility x:Key="GridViewGameCoverShowPlayedTime">Visible</Visibility>

    <!--Fluent Dim semantic palette. Opaque surfaces are distinct from overlays.-->
        <Color x:Key="WindowSurfaceColor">#282D35</Color>
        <Color x:Key="CardSurfaceColor">#303640</Color>
        <Color x:Key="PopupSurfaceColor">#383F4A</Color>
        <Color x:Key="HoverSurfaceColor">#414957</Color>
        <Color x:Key="SurfaceBorderColor">#505A69</Color>
        <Color x:Key="PrimaryTextColor">#E7EAF0</Color>
        <Color x:Key="SecondaryTextColor">#B5BDC9</Color>
        <Color x:Key="MutedTextColor">#9EA8B7</Color>
        <SolidColorBrush x:Key="CardSurfaceBrush" Color="{DynamicResource CardSurfaceColor}" />
        <SolidColorBrush x:Key="ControlOverlayBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ControlShadeBrush" Color="#000000" />
        <SolidColorBrush x:Key="ControlTrackBrush" Color="#29FFFFFF" />

    <!--Public theme resources: always usable directly by extension controls.-->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowSurfaceColor}" />
        <SolidColorBrush x:Key="DarkWindowBackgroundBrush" Color="{DynamicResource WindowSurfaceColor}" />

        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource CardSurfaceColor}" />
        <SolidColorBrush x:Key="DarkControlBackgroundBrush" Color="{DynamicResource CardSurfaceColor}" />

        <SolidColorBrush x:Key="ControlBorderBrush" Color="{DynamicResource SurfaceBorderColor}" />
        <SolidColorBrush x:Key="DarkControlBorderBrush" Color="{DynamicResource SurfaceBorderColor}" />

        <SolidColorBrush x:Key="ControlAccentBorderBrush" Color="{DynamicResource AccentSelectedColor}" />
        <SolidColorBrush x:Key="DarkControlAccentBorderBrush" Color="{DynamicResource AccentSelectedColor}" />

        <SolidColorBrush x:Key="PopupSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />

        <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupSurfaceColor}" />
        <SolidColorBrush x:Key="DarkPopupBackgroundBrush" Color="{DynamicResource PopupSurfaceColor}" />

        <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource SurfaceBorderColor}" />
        <SolidColorBrush x:Key="DarkPopupBorderBrush" Color="{DynamicResource SurfaceBorderColor}" />

        <!--
        Legacy light/dark resource names are compatibility aliases for the same
        palette. Internal templates use the ordinary, semantic resource names.
        -->
        <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="TextBrushLight" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource SecondaryTextColor}" />
        <SolidColorBrush x:Key="TextBrushLighter" Color="{DynamicResource MutedTextColor}" />
        <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource SurfaceBorderColor}" />
        <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource SurfaceBorderColor}" />
        <SolidColorBrush x:Key="NormalBorderBrush" Color="{DynamicResource SurfaceBorderColor}" />
        <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
        <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />

        <SolidColorBrush x:Key="AccentBackgroundBrush" Color="{DynamicResource AccentIdleColor}" />
        <SolidColorBrush x:Key="DarkAccentBackgroundBrush" Color="{DynamicResource AccentIdleColor}" />

        <!--
        Extension compatibility aliases.
        A number of Playnite extensions use these conventional theme resource
        names directly. Keep them mapped to Dune Rev's own palette so extension
        settings and injected controls remain legible.
        -->
        <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{DynamicResource WindowSurfaceColor}" />
        <SolidColorBrush x:Key="ControlForegroundBrush" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="CommonToolTipBackgroundBrush" Color="{DynamicResource PopupSurfaceColor}" />
        <SolidColorBrush x:Key="CommonToolTipBorderBrush" Color="{DynamicResource PanelSeparatorColor}" />
        <SolidColorBrush x:Key="CaretBrush" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource AccentSelectedColor}" />
        <SolidColorBrush x:Key="SelectionLightBrush" Color="{DynamicResource AccentSelectedColor}" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource CardSurfaceColor}" />
        <SolidColorBrush x:Key="LinkBrush" Color="{DynamicResource AccentSelectedColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentIdleColor}" />
        <SolidColorBrush x:Key="AccentColorBrush" Color="{DynamicResource AccentIdleColor}" />
        <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{DynamicResource AccentSelectedColor}" />
        <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2ecc71" />
        <SolidColorBrush x:Key="OverlayBrush" Color="#99000000" />
        <SolidColorBrush x:Key="OverlayMenuBackgroundBrush" Color="{DynamicResource PopupSurfaceColor}" />
        <SolidColorBrush x:Key="SectionHeaderBackgroundBrush" Color="#14FFFFFF" />

    <!--ThemeModifier Options Ends-->

    <sys:Double x:Key="FontSizeSmaller">10</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarge18">18</sys:Double>
    <sys:Double x:Key="FontSizeLarge20">20</sys:Double>
    <sys:Double x:Key="FontSizeLarge24">24</sys:Double>
    <sys:Double x:Key="FontSizeLarge28">28</sys:Double>
    <sys:Double x:Key="FontSizeLarge32">32</sys:Double>
    <sys:Double x:Key="FontSizeLarge40">40</sys:Double>
    <sys:Double x:Key="FontSizeLarge48">48</sys:Double>
    <FontFamily x:Key="FontFamily">Trebuchet MS</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusLargeX">24</CornerRadius>

    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Thickness x:Key="ButtonBorder">2</Thickness>

    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">#E7EAF0</Color>
    <Color x:Key="TextColorDarker">#B5BDC9</Color>
    <Color x:Key="TextColorLighter">#9EA8B7</Color>
    <Color x:Key="TextColorDark">#E7EAF0</Color>
    <Color x:Key="MainColor">#505A69</Color>
    <Color x:Key="MainColorDark">#282D35</Color>
    <Color x:Key="HoverColor">#414957</Color>
    <Color x:Key="GlyphColor">#E7EAF0</Color>
    <Color x:Key="HighlightGlyphColor">#59B5EF</Color>
    <Color x:Key="AccentIdleColor">#59B5EF</Color>
    <Color x:Key="AccentSelectedColor">#78C5F5</Color>

    <Color x:Key="BackgroundToneColor">#383F4A</Color>
    <Color x:Key="GridItemBackgroundColor">#303640</Color>

    <Color x:Key="PanelSeparatorColor">#33808080</Color>

    <Color x:Key="WindowPanelSeparatorColor">#14ffffff</Color>
    <Color x:Key="DataChangeNotifColor">#ffa500</Color>

    <!--Dune Rev palette additions-->
    <Color x:Key="8%White">#14FFFFFF</Color>
    <Color x:Key="16%White">#29FFFFFF</Color>
    <Color x:Key="24%White">#3DFFFFFF</Color>
    <Color x:Key="36%White">#5CFFFFFF</Color>
    <Color x:Key="40%White">#66FFFFFF</Color>
    <Color x:Key="Brown">#795548</Color>
    <Color x:Key="BrownDark">#280B0A</Color>
    <!--Dune Rev palette additions end-->

    <SolidColorBrush x:Key="GlobalBackgroundBrush" Color="Transparent" />

    <!--InputStyle-->
    <SolidColorBrush x:Key="ControlIdleBackgroundBrush" Color="{DynamicResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="ControlIdleBorderBrush" Color="{DynamicResource SurfaceBorderColor}" />

    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="{DynamicResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="{DynamicResource SurfaceBorderColor}" />

    <SolidColorBrush x:Key="ControlSelectedBackgroundBrush" Color="{DynamicResource HoverSurfaceColor}" />
    <!--InputStyle Ends-->

    <SolidColorBrush x:Key="ControlFilledHoverBackgroundBrush" Color="{DynamicResource 24%White}" />

    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="White60Brush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="White40Brush" Color="#66FFFFFF" />

    <!--ButtonStyle-->
    <SolidColorBrush x:Key="ButtonIdleBackgroundBrush" Color="{DynamicResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{DynamicResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="ButtonBrush" Color="{DynamicResource PrimaryTextColor}" />

    <SolidColorBrush x:Key="SecondaryButtonIdleBackgroundBrush" Color="{DynamicResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{DynamicResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="{DynamicResource PrimaryTextColor}" />
    <!--ButtonStyle Ends-->

    <SolidColorBrush x:Key="DisabledBrush" Color="{DynamicResource MutedTextColor}" />
    <SolidColorBrush x:Key="LinkButtonBrush" Color="{DynamicResource AccentSelectedColor}" />
    <SolidColorBrush x:Key="PromptBrush" Color="{DynamicResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="SubtalBrush" Color="{DynamicResource MutedTextColor}" />
    <SolidColorBrush x:Key="IdleBrush" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{DynamicResource PrimaryTextColor}" />

    <SolidColorBrush x:Key="AccentIdleBrush" Color="{DynamicResource AccentIdleColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentSelectedColor}" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#024DA3" />

    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{DynamicResource PopupSurfaceColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource CardSurfaceColor}" />

    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="Transparent" />

    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />

    <SolidColorBrush x:Key="CardSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource SurfaceBorderColor}" />

    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="#01875F" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="#C7212D" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="#f5C518" />

    <SolidColorBrush x:Key="WarningBrush" Color="#ff6b6b" />

    <LinearGradientBrush x:Key="ExpanderBackgroundBrush" StartPoint="-0.1,0.5" EndPoint="1.2,1" >
        <GradientStop Color="#FF2C3A67" Offset="0"/>
        <GradientStop Color="#002C3A67" Offset="0.7"/>
    </LinearGradientBrush>

    <ImageBrush x:Key="WindowImageBackgroundBrush">
        <ImageBrush.ImageSource>
            <BitmapImage UriSource="Images/GBackground.jpg"/>
        </ImageBrush.ImageSource>
    </ImageBrush>

    <ImageBrush x:Key="WindowImageBackgroundBrush1">
        <ImageBrush.ImageSource>
            <BitmapImage UriSource="Images/MainBackground.jpg"/>
        </ImageBrush.ImageSource>
    </ImageBrush>

    <SolidColorBrush x:Key="PlayButtonBrush" Color="#212121" />
    <SolidColorBrush x:Key="PlayButtonHoverBackgroundBrush" Color="#DBDBDB" />
    <LinearGradientBrush x:Key="PlayButtonBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1" >
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#EFEFEF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GridViewGameCoverSelectedBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC000000" Offset="0.3" />
        <GradientStop Color="#99000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LightTagBrush" StartPoint="0.5,0" EndPoint="0.5,1" >
        <GradientStop Color="#33FFFFFF" Offset="0.8"/>
        <GradientStop Color="#29FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DarkMaskBrush" StartPoint="0.5,0.4" EndPoint="0.5,1" >
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#B2000000" Offset="1"/>
    </LinearGradientBrush>

    <!--Compatibility name: masks follow the single palette as well.-->
    <LinearGradientBrush x:Key="LightMaskBrush" StartPoint="0.5,0.4" EndPoint="0.5,1" >
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#B2000000" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="RGLayerBackgroundBrush" GradientOrigin="0.5,1" Center="0.5,1" RadiusX="1" RadiusY="1">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="{DynamicResource 24%White}" Offset="0" />
            <GradientStop Color="Transparent" Offset="0.8" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="RGSelectedBackgroundBrush" GradientOrigin="0.5,1" Center="0.5,1" RadiusX="1" RadiusY="1">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="{DynamicResource 40%White}" Offset="0" />
            <GradientStop Color="{DynamicResource 24%White}" Offset="0.8" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="RGTubeLayerBackgroundBrush" GradientOrigin="0.6,1" Center="0.6,1" RadiusX="1" RadiusY="1">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="{DynamicResource 40%White}" Offset="0" />
            <GradientStop Color="{DynamicResource 24%White}" Offset="0.8" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

</ResourceDictionary>
