    <sys:String x:Key="LOCDuneMuteVideo">Mute video</sys:String>

    <Style x:Key="DuneDetailsHeroFooter" TargetType="Grid">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="40" />
        <Setter Property="Tag" Value="{DynamicResource DuneCompactLayout}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="24" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneGridHeroFooter" TargetType="Grid">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="24,0,24,24" />
        <Setter Property="Tag" Value="{DynamicResource DuneCompactLayout}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="16,0,16,16" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- IsSelected supplies one shared selection; a second toggle clears it. -->
    <Style x:Key="DuneCardToggle" TargetType="ToggleButton">
        <Setter Property="Panel.ZIndex" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DuneCardKeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Hover" Background="{DynamicResource ControlOverlayBrush}" Opacity="0"
                                CornerRadius="{DynamicResource ControlCornerRadiusLarge}" />
                        <Border x:Name="Selection" Background="{DynamicResource AccentBrush}" Opacity="0"
                                CornerRadius="{DynamicResource ControlCornerRadiusLarge}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Selection" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.03" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource ControlShadeBrush}" />
                            <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static Visibility.Collapsed}">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="ToolTip" Value="{DynamicResource LOCDuneEmbeddedUnavailable}" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DuneDetailIconButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DuneKeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Surface" Background="{DynamicResource ControlOverlayBrush}" Opacity="0"
                                CornerRadius="{DynamicResource DuneInputCornerRadius}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource DuneDisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The native plugin button remains the hit target above these visuals. -->
    <Style x:Key="DuneWindowIconSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlOverlayBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DuneInputCornerRadius}" />
        <Setter Property="Opacity" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                <Setter Property="Opacity" Value="0.08" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseCaptureWithin, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                <Setter Property="Opacity" Value="0.16" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DuneWindowIconFocus" TargetType="Border">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{DynamicResource DuneInputCornerRadius}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DuneDetailLink" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DuneKeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="Transparent"
                            CornerRadius="{DynamicResource DuneInputCornerRadius}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DuneInputFillBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DuneInputHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DuneLatestAchievement" TargetType="Grid">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="MinHeight" Value="56" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Tag, ElementName=DuneShowLatestAchievementPreference}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaseStyle" TargetType="Control">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DuneKeyboardFocus}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource DuneDisabledOpacity}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource DuneDisabledOpacity}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PanelTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="IconFontStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource DuneDisabledOpacity}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ItemsControl}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,8,0,0" />

    </Style>

    <!-- Scoped to embedded plugin content; do not replace plugin templates. -->
    <Style x:Key="DunePluginContent" TargetType="ContentControl">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Style.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding Content.Visibility, RelativeSource={RelativeSource Self}}" Value="Collapsed">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Overview addons share the page surface rather than an opaque empty card. -->
    <Style x:Key="DuneOverviewPluginPanel" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>

    <Style x:Key="DuneOptionalDetailText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DuneCatalogOpener" TargetType="ContentControl" BasedOn="{StaticResource DunePluginContent}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Opacity" Value="0.01" />
        <Setter Property="Panel.ZIndex" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Tag holds a local plugin icon path; Content supplies the Fluent fallback. -->
    <Style x:Key="DuneLocalPluginIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Image x:Name="PluginImage" Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="FallbackGlyph" Text="{TemplateBinding Content}" Visibility="Collapsed"
                                   Style="{StaticResource IconFontStyle}" FontSize="16" FontWeight="Normal"
                                   Foreground="{DynamicResource TextBrushDarker}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="PluginImage" Property="Source" Value="{x:Null}">
                            <Setter TargetName="PluginImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DuneSummaryHeadingIcon" TargetType="TextBlock" BasedOn="{StaticResource IconFontStyle}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="DuneSummaryChevron" TargetType="TextBlock" BasedOn="{StaticResource IconFontStyle}">
        <Setter Property="Text" Value="&#xE70D;" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Text" Value="&#xE70E;" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Basic motion belongs to the theme, including when Dune Materials is absent. -->
    <Style x:Key="DuneExpansionChevron" TargetType="TextBlock" BasedOn="{StaticResource DuneSummaryChevron}">
        <Setter Property="Text" Value="&#xE70D;" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform"><Setter.Value><RotateTransform /></Setter.Value></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Text" Value="&#xE70D;" />
                <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Tag, ElementName=DuneMotionPreference}" Value="False" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="DuneChevronOpen"><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="180" Duration="0:0:0.14" FillBehavior="Stop">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard></BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="DuneChevronOpen" /></MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False" />
                    <Condition Binding="{Binding Tag, ElementName=DuneMotionPreference}" Value="False" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="DuneChevronClose"><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="180" To="0" Duration="0:0:0.14" FillBehavior="Stop">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard></BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="DuneChevronClose" /></MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DunePluginEntrance" TargetType="Grid">
        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform /></Setter.Value></Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Tag.Managed, ElementName=DuneExpansionSizing, FallbackValue=False}" Value="False" />
                    <Condition Binding="{Binding Tag, ElementName=DuneMotionPreference}" Value="False" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="DunePanelEntrance"><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" FillBehavior="Stop" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="4" To="0" Duration="0:0:0.18" FillBehavior="Stop">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard></BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="DunePanelEntrance" /></MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DuneSummaryText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DuneSummaryProviderGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconFontStyle}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Heading and primary rows share fixed origins across every card size. -->
    <Style x:Key="DuneSummaryPrimaryText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <Style x:Key="DuneSummaryCompletionButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock Style="{StaticResource DuneSummaryPrimaryText}"
                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.6" /></Trigger>
        </Style.Triggers>
    </Style>
    <!-- Secondary information shares one density rule in both views. -->
    <Style x:Key="DuneSummarySecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Margin" Value="0" />
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneWideSummaryDetails" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=DuneSummaryDetailedPreference}" Value="True" />
                    <Condition Binding="{Binding ActualWidth, ElementName=DuneSummaryDetailBreakpoint}" Value="900" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Visibility, ElementName=DuneMainExtraDetail}" Value="Collapsed" />
                    <Condition Binding="{Binding Visibility, ElementName=DuneCompletionistDetail}" Value="Collapsed" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneActivitySummaryDetails" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Visibility, ElementName=DuneLastSessionDate}" Value="Collapsed" />
                    <Condition Binding="{Binding Visibility, ElementName=DuneRecentActivity}" Value="Collapsed" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DunePositiveSummaryValue" TargetType="Grid">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneRecentActivityText" TargetType="TextBlock" BasedOn="{StaticResource DuneSummarySecondaryText}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=DuneSummaryDetailedPreference}" Value="True" />
                    <Condition Binding="{Binding ActualWidth, ElementName=DuneSummaryDetailBreakpoint}" Value="900" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneSummaryProgress" TargetType="ProgressBar" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- One semantic state drives the requirements icon and label together. -->
    <Style x:Key="DuneRequirementsStatusIcon" TargetType="TextBlock" BasedOn="{StaticResource IconFontStyle}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Text" Value="&#xE721;" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Ready">
                <Setter Property="Text" Value="&#xE946;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Minimum">
                <Setter Property="Text" Value="&#xE73E;" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Recommended">
                <Setter Property="Text" Value="&#xE930;" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneRequirementsStatusText" TargetType="TextBlock" BasedOn="{StaticResource DuneSummaryPrimaryText}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Text" Value="{DynamicResource LOCOpen}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Ready">
                <Setter Property="Text" Value="{DynamicResource LOCDuneRequirementsReady}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Minimum">
                <Setter Property="Text" Value="{DynamicResource LOCDuneMinimumMet}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Recommended">
                <Setter Property="Text" Value="{DynamicResource LOCDuneRecommendedMet}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneHeroMediaTile" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource DuneActionSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DuneSurfaceEdgeBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DuneKeyboardFocus}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource DuneInputCornerRadius}" Padding="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DuneActionHoverBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DuneHeroMuteButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource DuneActionSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DuneSurfaceEdgeBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DuneKeyboardFocus}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource DuneInputCornerRadius}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DuneActionHoverBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>

    <!-- Native providers still own image downloads and video playback. -->
    <Style x:Key="DuneNativeHeroControls" TargetType="ContentControl">
        <Setter Property="Tag" Value="{Binding Content, ElementName=SteamScreenshots_SteamScreenshotsViewControl}" />
        <Setter Property="DataContext" Value="{Binding Content, ElementName=ExtraMetadataLoader_VideoLoaderControl}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Uid" Value="Background" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="50" />
                        </Grid.RowDefinitions>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Unloaded">
                                <i:InvokeCommandAction Command="{Binding VideoPauseCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <StackPanel x:Name="VideoControls" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8" Visibility="Collapsed">
                            <Button FocusVisualStyle="{StaticResource DuneKeyboardFocus}" Style="{DynamicResource DuneIconActionButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="32" Height="32" x:Name="NativePlayButton" Content="&#xE768;" ToolTip="{DynamicResource LOCDuneMediaPlay}"
                                    Command="{Binding DataContext.VideoPlayCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Button FocusVisualStyle="{StaticResource DuneKeyboardFocus}" Style="{DynamicResource DuneIconActionButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="32" Height="32" x:Name="NativePauseButton" Visibility="Collapsed" Content="&#xE769;" ToolTip="{DynamicResource LOCDuneMediaPause}" Margin="4,0,0,0"
                                    Command="{Binding DataContext.VideoPauseCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ToggleButton x:Name="NativeMuteButton" Style="{StaticResource DuneHeroMuteButton}" Content="&#xE74F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          ToolTip="{DynamicResource LOCDuneMediaMute}" Margin="4,0,0,0"
                                          IsChecked="{Binding DataContext.IsPlayerMuted, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton x:Name="BackgroundChoice" IsChecked="True" Style="{StaticResource DuneHeroMediaTile}"
                                         ToolTip="{DynamicResource LOCDuneMediaBackground}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Checked"><i:InvokeCommandAction Command="{Binding VideoPauseCommand}" /></i:EventTrigger>
                                </i:Interaction.Triggers>
                                <Grid Width="80" Height="42">
                                    <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Fill="{TemplateBinding Background}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="ScreenshotChoice" Style="{StaticResource DuneHeroMediaTile}" ToolTip="{DynamicResource LOCDuneStoreScreenshots}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Checked"><i:InvokeCommandAction Command="{Binding VideoPauseCommand}" /></i:EventTrigger>
                                </i:Interaction.Triggers>
                                <Image Source="{Binding Tag.CurrentImageBitmap, RelativeSource={RelativeSource TemplatedParent}}" Width="80" Height="42" Stretch="UniformToFill" />
                            </RadioButton>
                            <RadioButton x:Name="VideoChoice" Style="{StaticResource DuneHeroMediaTile}" Content="&#xE714;" ToolTip="{DynamicResource LOCDuneMediaVideo}"
                                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" />
                        </StackPanel>
                        <StackPanel x:Name="ScreenshotControls" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8" Visibility="Collapsed">
                            <Button FocusVisualStyle="{StaticResource DuneKeyboardFocus}" Style="{DynamicResource DuneIconActionButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="32" Height="32" Content="&#xE76B;" ToolTip="{DynamicResource LOCDuneMediaPrevious}"
                                    Command="{Binding Tag.SelectPreviousScreenshotCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Button FocusVisualStyle="{StaticResource DuneKeyboardFocus}" Style="{DynamicResource DuneIconActionButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="32" Height="32" Content="&#xE76C;" ToolTip="{DynamicResource LOCDuneMediaNext}" Margin="4,0,0,0"
                                    Command="{Binding Tag.SelectNextScreenshotCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Button FocusVisualStyle="{StaticResource DuneKeyboardFocus}" Style="{DynamicResource DuneIconActionButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="32" Height="32" Content="&#xE8A7;" ToolTip="{DynamicResource LOCDuneOpenPlugin}" Margin="4,0,0,0"
                                    Command="{Binding Tag.OpenScreenshotsViewCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.SettingsModel.Settings.IsVideoPlaying, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="True">
                            <Setter TargetName="NativePlayButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="NativePauseButton" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.IsPlayerMuted, RelativeSource={RelativeSource Self}, FallbackValue=True}" Value="False">
                            <Setter TargetName="NativeMuteButton" Property="Content" Value="&#xE767;" />
                        </DataTrigger>
                        <Trigger SourceName="ScreenshotChoice" Property="IsChecked" Value="True">
                            <Setter Property="Uid" Value="Screenshots" />
                            <Setter TargetName="ScreenshotControls" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger SourceName="VideoChoice" Property="IsChecked" Value="True">
                            <Setter Property="Uid" Value="Video" />
                            <Setter TargetName="VideoControls" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag.CurrentImageBitmap, RelativeSource={RelativeSource Self}, FallbackValue={x:Null}}" Value="{x:Null}">
                            <Setter TargetName="ScreenshotChoice" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ScreenshotControls" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag.Visibility, RelativeSource={RelativeSource Self}}" Value="Collapsed">
                            <Setter TargetName="ScreenshotChoice" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ScreenshotControls" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.VideoSource, RelativeSource={RelativeSource Self}, FallbackValue={x:Null}}" Value="{x:Null}">
                            <Setter TargetName="VideoChoice" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="VideoControls" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Content, ElementName=DuneHeroMedia, FallbackValue={x:Null}}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Plugin adapters: preserve native content, data paths and command ownership. -->
    <!-- Steam Store Screenshots Viewer -->
    <Style x:Key="DuneHeroStoreScreenshotLayer" TargetType="Grid">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=DuneHeroMediaSelection}" Value="Screenshots" />
                    <Condition Binding="{Binding Content.Visibility, ElementName=SteamScreenshots_SteamScreenshotsViewControl}" Value="Visible" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Content.CurrentImageBitmap, ElementName=SteamScreenshots_SteamScreenshotsViewControl}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Content.Screenshots.Count, ElementName=SteamScreenshots_SteamScreenshotsViewControl}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <!-- This provider returns a transparent 160x90 bitmap on failed downloads. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Content.CurrentImageBitmap.PixelWidth, ElementName=SteamScreenshots_SteamScreenshotsViewControl}" Value="160" />
                    <Condition Binding="{Binding Content.CurrentImageBitmap.PixelHeight, ElementName=SteamScreenshots_SteamScreenshotsViewControl}" Value="90" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Visibility, RelativeSource={RelativeSource Self}}" Value="Visible" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                    <Condition Binding="{Binding Tag, ElementName=DuneMotionPreference}" Value="False" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="DuneHeroScreenshotFade">
                        <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" FillBehavior="Stop" /></Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="DuneHeroScreenshotFade" /></MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <!-- A data-only presentation of the Hero's native provider; never reparent its UserControl. -->
    <Style x:Key="DuneStoreScreenshotsContent" TargetType="ContentControl">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid DataContext="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid.InputBindings>
                            <KeyBinding Key="Left" Command="{Binding SelectPreviousScreenshotCommand}" />
                            <KeyBinding Key="Right" Command="{Binding SelectNextScreenshotCommand}" />
                        </Grid.InputBindings>
                        <!-- The native provider stays loaded in Hero and owns context, downloads and commands. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Command="{Binding OpenScreenshotsViewCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    ToolTip="{DynamicResource LOCDuneStoreScreenshots}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter ContentSource="Content" />
                                    </ControlTemplate>
                                </Button.Template>
                                <Image Source="{Binding CurrentImageBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Button>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{DynamicResource DunePluginIconButton}" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                                        Command="{Binding SelectPreviousScreenshotCommand}" Margin="0,0,8,0" />
                                <ListBox Grid.Column="1" Height="100" Background="Transparent" BorderThickness="0"
                                         ItemsSource="{Binding Screenshots}"
                                         SelectedItem="{Binding SelectedScreenshot, Mode=TwoWay}"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="3" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                            <Setter Property="VerticalContentAlignment" Value="Top" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ThumbnailBorder" BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ThumbnailBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ThumbnailBorder" Property="BorderBrush" Value="{DynamicResource TextBrush}" /></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><Image Source="{Binding ThumbnailImage}" Height="64" Width="114" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" /></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Column="2" Style="{DynamicResource DunePluginIconButton}" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                        Command="{Binding SelectNextScreenshotCommand}" Margin="8,0,0,0" />
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain content presentation remains available without the companion extension. -->
    <ControlTemplate x:Key="DunePlainSizingTemplate" TargetType="ContentControl">
        <ContentPresenter Content="{TemplateBinding Content}" />
    </ControlTemplate>
    <Style x:Key="DuneSizingHost" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template" Value="{StaticResource DunePlainSizingTemplate}" />
    </Style>
    <Style x:Key="DuneExpansionSizingHost" TargetType="ContentControl" BasedOn="{StaticResource DuneSizingHost}">
        <Setter Property="Visibility" Value="{Binding Visibility, ElementName=DuneDetailHeader}" />
        <Setter Property="Template" Value="{Binding RelativeSource={RelativeSource Self}, Converter={PluginConverter Plugin=DuneMaterials, Converter=ExpansionLayoutTemplateConverter}, ConverterParameter=Expansion, FallbackValue={StaticResource DunePlainSizingTemplate}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag.KeepVisible, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneMetadataSizingHost" TargetType="ContentControl" BasedOn="{StaticResource DuneSizingHost}">
        <Setter Property="Template" Value="{Binding RelativeSource={RelativeSource Self}, Converter={PluginConverter Plugin=DuneMaterials, Converter=ExpansionLayoutTemplateConverter}, ConverterParameter=Metadata, FallbackValue={StaticResource DunePlainSizingTemplate}}" />
    </Style>

    <!-- CheckDlc -->
    <!-- Keep the native DLC control loaded for its data and action handlers. Its
         self-sized ListBox cannot measure natural height; reuse its row template
         in a bounded, automatically sized list instead. -->
    <Style x:Key="DuneDlcContent" TargetType="ContentControl" BasedOn="{StaticResource DunePluginContent}">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter ContentSource="Content" Opacity="0" IsHitTestVisible="False" KeyboardNavigation.TabNavigation="None" />
                        <!-- The native row template resolves description width through this name. -->
                        <Grid x:Name="PART_GridContener" Grid.Row="1">
                            <ListBox x:Name="DuneDlcList"
                                 MaxHeight="{DynamicResource DuneDlcPanelHeight}"
                                 ItemsSource="{Binding Content.DataContext.ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                 ItemTemplate="{Binding Content.Content.Children[0].ItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
