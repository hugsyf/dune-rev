<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style x:Key="DuneKeyboardFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="2" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource TextBrush}" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- English fallback; Playnite loads localized overrides from Localization/. -->
    <sys:String x:Key="LOCDuneAchievements">Achievements</sys:String>
    <sys:String x:Key="LOCDuneLatestAchievement">Latest unlock</sys:String>
    <sys:String x:Key="LOCDuneSystemRequirements">System requirements</sys:String>
    <sys:String x:Key="LOCDuneRequirementsReady">View requirements</sys:String>
    <sys:String x:Key="LOCDuneMainStory">Main story estimate &#x00B7; HowLongToBeat</sys:String>

    <sys:String x:Key="LOCDuneMainStoryLabel">Main story estimate</sys:String>
    <sys:String x:Key="LOCDuneMainExtra">Main + extras</sys:String>
    <sys:String x:Key="LOCDuneCompletionist">Completionist</sys:String>
    <sys:String x:Key="LOCDuneLastSession">Last session</sys:String>
    <sys:String x:Key="LOCDuneMinimumMet">Minimum met</sys:String>
    <sys:String x:Key="LOCDuneRecommendedMet">Recommended met</sys:String>
    <sys:String x:Key="LOCDuneLanguages">Languages</sys:String>
    <sys:String x:Key="LOCDuneDlc">DLC</sys:String>
    <sys:String x:Key="LOCDuneLanguageDetails">View language support</sys:String>
    <sys:String x:Key="LOCDunePreferredLanguageListed">Preferred language listed</sys:String>
    <sys:String x:Key="LOCDunePreferredLanguageMissing">Preferred language not listed</sys:String>
    <sys:String x:Key="LOCDunePreferredLanguageHint">Matches the preferred languages configured in CheckLocalizations. Interface, audio and subtitles are listed separately in Languages.</sys:String>
    <sys:String x:Key="LOCDuneLanguagesRecorded">languages recorded</sys:String>
    <sys:String x:Key="LOCDuneDlcCatalogHint">Catalog and ownership are reported by CheckDlc, including manual ownership and ignored entries.</sys:String>
    <sys:String x:Key="LOCDuneDlcCatalog">DLC catalog</sys:String>
    <sys:String x:Key="LOCDuneDlcItems">DLC entries</sys:String>
    <sys:String x:Key="LOCDuneDlcAll">All</sys:String>
    <sys:String x:Key="LOCDuneDlcOwned">Owned</sys:String>
    <sys:String x:Key="LOCDuneDlcNotOwned">Not owned</sys:String>
    <sys:String x:Key="LOCDuneLanguageListHint">Interface, audio and subtitle support are reported separately. Scroll horizontally for all columns.</sys:String>
    <sys:String x:Key="LOCDuneEmptyDlcCategory">No DLC in this category.</sys:String>
    <sys:String x:Key="LOCDuneSource">Source:</sys:String>
    <sys:String x:Key="LOCDuneOpenPlugin">Open in plugin</sys:String>
    <sys:String x:Key="LOCDuneCollapseDetails">Collapse</sys:String>
    <sys:String x:Key="LOCDuneCloseDetails">Close game details</sys:String>
    <sys:String x:Key="LOCDuneThemeSettings">Theme settings</sys:String>
    <Style x:Key="DuneDetailsHeroFooter" TargetType="Grid">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="40" />
        <Setter Property="Tag" Value="{DynamicResource DuneCompactLayout}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="True"><Setter Property="Margin" Value="24" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneGridHeroFooter" TargetType="Grid">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="24,0,24,24" />
        <Setter Property="Tag" Value="{DynamicResource DuneCompactLayout}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="True"><Setter Property="Margin" Value="16,0,16,16" /></Trigger>
        </Style.Triggers>
    </Style>
    <sys:String x:Key="LOCDuneEmbeddedUnavailable">Expandable details are unavailable.</sys:String>
    <sys:String x:Key="LOCDuneSolo">Single-player</sys:String>
    <sys:String x:Key="LOCDuneCoOp">Co-op</sys:String>
    <sys:String x:Key="LOCDuneVs">Competitive</sys:String>
    <sys:String x:Key="LOCDuneSessionHistory">Session history</sys:String>
    <sys:String x:Key="LOCDunePerformanceHistory">Performance history</sys:String>
    <sys:String x:Key="LOCDuneAverageFps">Average FPS</sys:String>
    <sys:String x:Key="LOCDuneTimeEstimates">Completion time estimates</sys:String>

    <!-- IsSelected supplies one shared selection; a second toggle clears it. -->
    <Style x:Key="DuneCardToggle" TargetType="ToggleButton">
        <Setter Property="Panel.ZIndex" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DuneKeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Hover" Background="{DynamicResource ControlOverlayBrush}" Opacity="0"
                                CornerRadius="{DynamicResource ControlCornerRadiusLarge}" />
                        <Border x:Name="Outline" Background="Transparent" BorderThickness="2"
                                BorderBrush="Transparent" CornerRadius="{DynamicResource ControlCornerRadiusLarge}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.16" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static Visibility.Collapsed}">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="ToolTip" Value="{DynamicResource LOCDuneEmbeddedUnavailable}" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DuneDetailIconButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DuneKeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Surface" Background="{DynamicResource ControlOverlayBrush}" Opacity="0"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The native plugin button remains the hit target above these visuals. -->
    <Style x:Key="DuneWindowIconSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlOverlayBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Opacity" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                <Setter Property="Opacity" Value="0.08" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseCaptureWithin, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                <Setter Property="Opacity" Value="0.16" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DuneWindowIconFocus" TargetType="Border">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DuneDetailLink" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DuneKeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="Transparent"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DuneLatestAchievement" TargetType="Grid">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="MinHeight" Value="56" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Tag, ElementName=DuneShowLatestAchievementPreference}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaseStyle" TargetType="Control">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DuneKeyboardFocus}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PanelTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="IconFontStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ItemsControl}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,8,0,0" />

    </Style>

    <!-- Scoped to embedded plugin content; do not replace plugin templates. -->
    <Style x:Key="DunePluginContent" TargetType="ContentControl">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Style.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding Content.Visibility, RelativeSource={RelativeSource Self}}" Value="Collapsed">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DuneMetadataContent" TargetType="ContentControl" BasedOn="{StaticResource DunePluginContent}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Public Metadata Utilities style keys; the addon owns field grouping and editing. -->
    <Style x:Key="MdStyleTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,8,6" />
    </Style>
    <Style x:Key="MdStyleIcon" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style x:Key="MdStyleItemButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style x:Key="DunePluginPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadiusLarge}" />
        <Setter Property="Padding" Value="16,16,16,0" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>

    <!-- Keep the native DLC control loaded for its data and action handlers. Its
         self-sized ListBox cannot measure natural height; reuse its row template
         in a bounded, automatically sized list instead. -->
    <Style x:Key="DuneDlcContent" TargetType="ContentControl" BasedOn="{StaticResource DunePluginContent}">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter ContentSource="Content" Opacity="0" IsHitTestVisible="False" KeyboardNavigation.TabNavigation="None" />
                        <!-- The native row template resolves description width through this name. -->
                        <Grid x:Name="PART_GridContener" Grid.Row="1">
                            <!-- A sizing spacer preserves the default short-list height without
                                 imposing a minimum on the scroll viewport in a short sidebar. -->
                            <Border x:Name="DuneDlcDefaultHeight" Height="{DynamicResource DuneDlcPanelHeight}" Visibility="Hidden" IsHitTestVisible="False" />
                            <ListBox x:Name="DuneDlcList"
                                 ItemsSource="{Binding Content.DataContext.ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                 ItemTemplate="{Binding Content.Content.Children[0].ItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DuneOptionalDetailText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DuneCatalogOpener" TargetType="ContentControl" BasedOn="{StaticResource DunePluginContent}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Opacity" Value="0.01" />
        <Setter Property="Panel.ZIndex" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Tag holds a local plugin icon path; Content supplies the Fluent fallback. -->
    <Style x:Key="DuneLocalPluginIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Image x:Name="PluginImage" Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="FallbackGlyph" Text="{TemplateBinding Content}" Visibility="Collapsed"
                                   Style="{StaticResource IconFontStyle}" FontSize="16" FontWeight="Normal"
                                   Foreground="{DynamicResource TextBrushDarker}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="PluginImage" Property="Source" Value="{x:Null}">
                            <Setter TargetName="PluginImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DuneSummaryProviderGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconFontStyle}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Heading and primary rows share fixed origins across every card size. -->
    <Style x:Key="DuneSummaryPrimaryText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <Style x:Key="DuneSummaryCompletionButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock Style="{StaticResource DuneSummaryPrimaryText}"
                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.6" /></Trigger>
        </Style.Triggers>
    </Style>
    <!-- Secondary information shares one density rule in both views. -->
    <Style x:Key="DuneSummarySecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Margin" Value="0" />
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneWideSummaryDetails" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=DuneSummaryDetailedPreference}" Value="True" />
                    <Condition Binding="{Binding ActualWidth, ElementName=DuneSummaryDetailBreakpoint}" Value="900" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Visibility, ElementName=DuneMainExtraDetail}" Value="Collapsed" />
                    <Condition Binding="{Binding Visibility, ElementName=DuneCompletionistDetail}" Value="Collapsed" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneActivitySummaryDetails" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Visibility, ElementName=DuneLastSessionDate}" Value="Collapsed" />
                    <Condition Binding="{Binding Visibility, ElementName=DuneRecentActivity}" Value="Collapsed" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DunePositiveSummaryValue" TargetType="Grid">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneRecentActivityText" TargetType="TextBlock" BasedOn="{StaticResource DuneSummarySecondaryText}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, ElementName=DuneSummaryDetailedPreference}" Value="True" />
                    <Condition Binding="{Binding ActualWidth, ElementName=DuneSummaryDetailBreakpoint}" Value="900" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DuneSummaryProgress" TargetType="ProgressBar" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- One semantic state drives the requirements icon and label together. -->
    <Style x:Key="DuneRequirementsStatusIcon" TargetType="TextBlock" BasedOn="{StaticResource IconFontStyle}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Text" Value="&#xE721;" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Ready">
                <Setter Property="Text" Value="&#xE946;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Minimum">
                <Setter Property="Text" Value="&#xE73E;" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Recommended">
                <Setter Property="Text" Value="&#xE930;" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
